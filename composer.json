{
  "name":"metfpa/e2c-recrutement-v2",
  "type":"project",
  "require":{
    "php":">=8.4",
    "ext-ctype":"*","ext-iconv":"*","ext-pdo":"*","ext-pdo_mysql":"*",
    "symfony/framework-bundle":"7.4.*","symfony/console":"7.4.*","symfony/dotenv":"7.4.*",
    "symfony/runtime":"7.4.*","symfony/twig-bundle":"7.4.*","symfony/security-bundle":"7.4.*",
    "symfony/asset":"7.4.*","symfony/form":"7.4.*","symfony/validator":"7.4.*",
    "symfony/mailer":"^7.4","symfony/mime":"7.4.*","symfony/monolog-bundle":"3.10.*",
    "symfony/translation":"7.4.*","doctrine/orm":"3.7.*","doctrine/doctrine-bundle":"3.3.*",
    "doctrine/doctrine-migrations-bundle":"3.7.*","doctrine/migrations":"3.9.*",
    "twig/twig":"^3.22","twig/extra-bundle":"^3.22","nesbot/carbon":"^3.10",
    "symfony/yaml": "7.4.*",
    "symfonycasts/reset-password-bundle": "*",
    "symfony/expression-language": "^7.4",
    "phpoffice/phpspreadsheet": "^5.11",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev":{"symfony/maker-bundle":"^1.64","symfony/web-profiler-bundle":"7.4.*",
    "symfony/test-pack": "^1.2"},
  "autoload":{"psr-4":{"App\\":"src/"}},
  "autoload-dev":{"psr-4":{"App\\Tests\\":"tests/"}},
  "scripts":{"auto-scripts":{"cache:clear":"symfony-cmd","assets:install %PUBLIC_DIR%":"symfony-cmd"},"post-install-cmd":["@auto-scripts"]},
  "extra":{"symfony":{"allow-contrib":true,"require":"7.4.*"}},
  "minimum-stability":"stable","prefer-stable":true,
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
