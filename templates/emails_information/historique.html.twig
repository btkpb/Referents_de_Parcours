{% extends 'base.html.twig' %}

{% block title %}Historique des e-mails d'information{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="card border-0 shadow-sm mb-4" style="background:linear-gradient(120deg,#164b78,#2878b8);color:white;">
        <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="h3 mb-2 text-white">Historique des e-mails d'information</h1>
                <p class="mb-0 text-white">Suivi des tentatives et des résultats d'envoi</p>
            </div>
            <a href="{{ path('email_information_index') }}" class="btn btn-light">Nouvel e-mail</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Audience</th>
                        <th>Destinataire</th>
                        <th>E-mail</th>
                        <th>Objet</th>
                        <th>Statut</th>
                        <th>Détail erreur</th>
                    </tr>
                </thead>
                <tbody>
                {% for ligne in historique %}
                    <tr>
                        <td>{{ ligne.date_tentative|date('d/m/Y H:i') }}</td>
                        <td>{{ ligne.audience == 'CANDIDAT' ? 'Candidat' : 'Apprenti' }}</td>
                        <td>{{ ligne.nom_destinataire }}</td>
                        <td>{{ ligne.email_destinataire }}</td>
                        <td>{{ ligne.sujet }}</td>
                        <td>
                            {% if ligne.statut == 'ENVOYE' %}
                                <span class="badge bg-success">Envoyé</span>
                            {% elseif ligne.statut == 'ECHEC' %}
                                <span class="badge bg-danger">Échec</span>
                            {% else %}
                                <span class="badge bg-warning text-dark">{{ ligne.statut }}</span>
                            {% endif %}
                        </td>
                        <td>{{ ligne.erreur|default('—') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Aucun envoi enregistré.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}