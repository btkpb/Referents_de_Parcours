{% extends 'base.html.twig' %}

{% block title %}Espace Maître de stage{% endblock %}

{% block body %}
<div class="container-fluid py-3 text-end">
    <a href="{{ path('maitre_stage_index', app.request.query.all|merge({'affichage':'moderne'})) }}"
       class="btn btn-primary btn-sm fw-semibold">
        ↶ Revenir au design professionnel
    </a>
</div>
<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Espace Maître de stage</h1>
            <p class="text-muted mb-0">
    Compte connecté :
    <strong>{{ utilisateurNomComplet|upper }}</strong>
    · {{ profilEspace }} — Suivi des apprentis en entreprise
</p>
        </div>
        <span class="badge bg-primary fs-6">
            {{ lignes|length }} affectation(s)
        </span>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h5">Apprentis suivis en entreprise</h2>
            <p class="text-muted mb-0">
                Cette liste repose sur les affectations officielles des
                Maîtres de stage et des Référents de parcours.
                Les affectations terminées sont conservées pour assurer
                la traçabilité historique.
            </p>
        </div>
    </div>

    {% if lignes is empty %}
        <div class="alert alert-info">
            Aucun apprenti ne vous est actuellement associé dans le système
            d’affectation.
        </div>
    {% else %}
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N° apprenti</th>
                            <th>Nom et prénoms</th>
                            <th>Métier</th>
                            <th>Début de l’affectation</th>
                            <th>Fin de l’affectation</th>
                            <th>Situation</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for ligne in lignes %}
                        {% set candidat = ligne.candidat %}
                        {% set affectation = ligne.affectation %}
                        <tr>
                            <td>{{ candidat.numero|default('—') }}</td>
                            <td>
                                <strong>
                                    {{ candidat.nom|default('') }}
                                    {{ candidat.prenoms|default('') }}
                                </strong>
                            </td>
                            <td>{{ candidat.metier|default('—') }}</td>
                            <td>
                                {{ affectation.dateDebut
                                    ? affectation.dateDebut|date('d/m/Y')
                                    : '—' }}
                            </td>
                            <td>
                                {{ affectation.dateFin
                                    ? affectation.dateFin|date('d/m/Y')
                                    : '—' }}
                            </td>
                            <td>
                                {% if ligne.active %}
                                    <span class="badge bg-success">En cours</span>
                                {% else %}
                                    <span class="badge bg-secondary">Historique</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if profilEspace == 'Maître de stage' and ligne.active %}
                                    <a class="btn btn-sm btn-primary"
                                       href="{{ path('maitre_stage_evaluation_nouvelle', {id: candidat.id}) }}">
                                        Nouvelle fiche
                                    </a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="alert alert-secondary mt-4">
        <strong>Fiche officielle :</strong>
        les évaluations techniques utiliseront les compétences du
        Référentiel de Formation correspondant au métier de l’apprenti.
        Aucun énoncé de compétence fictif n’est préchargé.
    </div>

</div>
{% endblock %}