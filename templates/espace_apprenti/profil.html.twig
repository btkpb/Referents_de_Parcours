{% extends 'base.html.twig' %}

{% block title %}Mon profil - E2C-MENAET{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .profil-page {
            --profil-blue: #145da0;
            --profil-dark: #173b5e;
            --profil-muted: #718096;
            color: #24364b;
            padding-bottom: 35px;
        }

        .profil-banner {
            position: relative;
            overflow: hidden;
            padding: 30px;
            margin-bottom: 25px;
            border-radius: 20px;
            color: #fff;
            background: linear-gradient(120deg, #123f70, #1976b9);
            box-shadow: 0 10px 28px rgba(20, 93, 160, .17);
        }

        .profil-banner::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -65px;
            top: -105px;
            border: 30px solid rgba(255,255,255,.08);
            border-radius: 50%;
        }

        .profil-eyebrow {
            font-size: .75rem;
            letter-spacing: 2px;
            font-weight: 800;
            text-transform: uppercase;
            opacity: .8;
        }

        .profil-banner h1 {
            font-size: clamp(1.6rem, 3vw, 2.2rem);
            font-weight: 800;
            margin: 8px 0;
        }

        .profil-banner p {
            margin: 0;
            color: rgba(255,255,255,.86);
        }

        .profil-layout {
            display: grid;
            grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
            gap: 22px;
            align-items: start;
        }

        .profil-card {
            background: #fff;
            border: 1px solid #e5edf5;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 5px 22px rgba(31,67,105,.055);
        }

        .profil-identity {
            text-align: center;
            padding: 30px 22px 25px;
            background: linear-gradient(180deg, #f0f7ff, #fff 75%);
        }

        .profil-photo {
            width: 150px;
            height: 150px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #fff;
            box-shadow: 0 5px 22px rgba(20,65,105,.17);
            background: #e5eff9;
        }

        .profil-avatar {
            color: #145da0;
            font-size: 2.7rem;
            font-weight: 800;
        }

        .profil-name {
            margin-top: 18px;
            color: #173b5e;
            font-size: 1.28rem;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

        .profil-job {
            color: #64748b;
            font-size: .94rem;
            margin-top: 5px;
        }

        .profil-reference {
            margin-top: 22px;
            padding: 13px;
            border: 1px solid #e5edf5;
            background: #fff;
            border-radius: 12px;
            text-align: left;
        }

        .profil-reference small {
            display: block;
            color: #718096;
            margin-bottom: 4px;
        }

        .profil-reference strong {
            color: #173b5e;
            overflow-wrap: anywhere;
        }

        .profil-status {
            display: inline-block;
            margin-top: 15px;
            padding: 8px 15px;
            border-radius: 30px;
            background: #e8f3ff;
            color: #145da0;
            font-size: .8rem;
            font-weight: 750;
        }

        .profil-content {
            display: grid;
            gap: 22px;
        }

        .profil-section-title {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 19px 22px;
            border-bottom: 1px solid #edf2f7;
            color: #173b5e;
            font-weight: 800;
            font-size: 1rem;
        }

        .profil-section-icon {
            display: inline-flex;
            width: 36px;
            height: 36px;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: #eaf4ff;
            color: #145da0;
            font-size: 1.1rem;
        }

        .profil-fields {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0 25px;
            padding: 8px 22px 18px;
        }

        .profil-field {
            padding: 15px 0;
            border-bottom: 1px solid #edf2f7;
            min-width: 0;
        }

        .profil-field dt {
            color: #718096;
            font-size: .82rem;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .profil-field dd {
            color: #24364b;
            font-weight: 750;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .profil-note {
            margin-top: 22px;
            padding: 15px 18px;
            border-radius: 13px;
            background: #f0f7ff;
            color: #36516d;
            font-size: .88rem;
        }

        @media(max-width: 850px) {
            .profil-layout {
                grid-template-columns: 1fr;
            }
        }

        @media(max-width: 576px) {
            .profil-banner {
                padding: 23px 20px;
            }

            .profil-fields {
                grid-template-columns: 1fr;
                padding-left: 19px;
                padding-right: 19px;
            }

            .profil-section-title {
                padding: 16px 19px;
            }

            .profil-photo {
                width: 130px;
                height: 130px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid profil-page">

    {% include 'espace_apprenti/_menu.html.twig' %}

    <section class="profil-banner">
        <div class="profil-eyebrow">E2C - MENAET / Espace personnel</div>
        <h1 class="text-white">Mon profil apprenti</h1>
        <p>Retrouvez et consultez vos informations personnelles et votre dossier de formation.</p>
    </section>

    <div class="profil-layout">

        <aside class="profil-card">
            <div class="profil-identity">

                {% if photoDisponible %}
                    <img
                        src="{{ path('candidat_photo_identite', {'id': candidat.id}) }}"
                        alt="Photo d'identité de {{ candidat.prenoms }} {{ candidat.nom }}"
                        class="profil-photo"
                    >
                {% else %}
                    <div class="profil-photo profil-avatar">
                        {{ candidat.prenoms|default('?')|first|upper }}{{ candidat.nom|default('?')|first|upper }}
                    </div>
                {% endif %}

                <div class="profil-name">
                    {{ candidat.prenoms|default('') }} {{ candidat.nom|default('') }}
                </div>

                <div class="profil-job">
                    {{ candidat.metier|default('Métier non renseigné') }}
                </div>

                <div class="profil-status">
                    {{ candidat.statut|default('Statut non renseigné') }}
                </div>

                <div class="profil-reference">
                    <small>Numéro de dossier</small>
                    <strong>{{ candidat.numero|default('Non renseigné') }}</strong>
                </div>

            </div>
        </aside>

        <div class="profil-content">

            <section class="profil-card">
                <div class="profil-section-title">
                    <span class="profil-section-icon">♙</span>
                    Identité et informations personnelles
                </div>

                <dl class="profil-fields mb-0">
                    <div class="profil-field">
                        <dt>Nom</dt>
                        <dd>{{ candidat.nom|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Prénoms</dt>
                        <dd>{{ candidat.prenoms|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Sexe</dt>
                        <dd>{{ candidat.sexe|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Date de naissance</dt>
                        <dd>
                            {% if candidat.dateNaissance %}
                                {{ candidat.dateNaissance|date('d/m/Y') }}
                            {% else %}
                                Non renseignée
                            {% endif %}
                        </dd>
                    </div>

                    <div class="profil-field">
                        <dt>Lieu de naissance</dt>
                        <dd>{{ candidat.lieuNaissance|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Nationalité</dt>
                        <dd>{{ candidat.nationalite|default('Non renseignée') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Téléphone</dt>
                        <dd>{{ candidat.telephone|default('Non renseigné') }}</dd>
                    </div>
                </dl>
            </section>

            <section class="profil-card">
                <div class="profil-section-title">
                    <span class="profil-section-icon">▤</span>
                    Formation et parcours professionnel
                </div>

                <dl class="profil-fields mb-0">
                    <div class="profil-field">
                        <dt>Métier de formation</dt>
                        <dd>{{ candidat.metier|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Niveau d'études</dt>
                        <dd>{{ candidat.niveau|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Dernier diplôme</dt>
                        <dd>{{ candidat.diplome|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Ancien métier</dt>
                        <dd>{{ candidat.ancienMetier|default('Non renseigné') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Disponibilité</dt>
                        <dd>{{ candidat.disponibilite|default('Non renseignée') }}</dd>
                    </div>

                    <div class="profil-field">
                        <dt>Statut du dossier</dt>
                        <dd>{{ candidat.statut|default('Non renseigné') }}</dd>
                    </div>
                </dl>
            </section>

        </div>
    </div>

    <div class="profil-note">
        <strong>Information :</strong>
        Ces informations correspondent aux données enregistrées dans votre dossier E2C-MENAET.
        En cas d'erreur, veuillez contacter le service chargé de votre suivi.
    </div>

</div>
{% endblock %}