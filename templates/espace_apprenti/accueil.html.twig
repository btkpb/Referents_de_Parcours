{% extends 'base.html.twig' %}

{% block title %}Mon espace apprenti - E2C-MENAET{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .apprenti-page {
            --ap-primary: #145DA0;
            --ap-secondary: #287FBD;
            --ap-dark: #193653;
            --ap-muted: #718096;
            --ap-border: #e5edf5;
            color: var(--ap-dark);
            padding-bottom: 35px;
        }

        .apprenti-hero {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            padding: 36px;
            border-radius: 22px;
            color: #fff;
            background: linear-gradient(120deg, #103e70 0%, #145DA0 55%, #318bc5 100%);
            box-shadow: 0 12px 30px rgba(20, 93, 160, .18);
        }

        .apprenti-hero::after {
            content: "";
            position: absolute;
            z-index: -1;
            width: 260px;
            height: 260px;
            right: -65px;
            top: -115px;
            border: 35px solid rgba(255,255,255,.09);
            border-radius: 50%;
        }

        .apprenti-hero::before {
            content: "";
            position: absolute;
            z-index: -1;
            width: 150px;
            height: 150px;
            right: 130px;
            bottom: -105px;
            background: rgba(255,255,255,.07);
            border-radius: 50%;
        }

        .apprenti-hero .eyebrow {
            color: #d8ebff;
            font-size: .78rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .apprenti-hero h1 {
            font-size: clamp(1.55rem, 3vw, 2.25rem);
            line-height: 1.25;
            font-weight: 800;
        }

        .apprenti-hero p {
            color: rgba(255,255,255,.86);
            max-width: 650px;
            line-height: 1.7;
        }

        .apprenti-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 11px 17px;
            border: 1px solid rgba(255,255,255,.3);
            border-radius: 50px;
            background: rgba(255,255,255,.13);
            color: #fff;
            font-size: .88rem;
            font-weight: 700;
        }

        .apprenti-section-heading {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 18px;
        }

        .apprenti-section-heading .heading-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 39px;
            height: 39px;
            border-radius: 12px;
            background: #eaf4ff;
            color: var(--ap-primary);
            font-size: 19px;
        }

        .apprenti-section-heading h2 {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--ap-dark);
        }

        .apprenti-card {
            position: relative;
            height: 100%;
            min-height: 220px;
            padding: 23px;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--ap-border);
            border-radius: 18px;
            box-shadow: 0 5px 18px rgba(31,67,105,.045);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .apprenti-card:hover {
            transform: translateY(-5px);
            border-color: #b9d8f5;
            box-shadow: 0 13px 28px rgba(31,67,105,.10);
        }

        .apprenti-card-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 52px;
            height: 52px;
            margin-bottom: 17px;
            border-radius: 15px;
            background: #eaf4ff;
            color: var(--ap-primary);
            font-size: 25px;
        }

        .apprenti-card h3 {
            margin-bottom: 9px;
            color: var(--ap-dark);
            font-size: 1.04rem;
            font-weight: 800;
        }

        .apprenti-card p {
            min-height: 48px;
            margin-bottom: 15px;
            color: var(--ap-muted);
            font-size: .88rem;
            line-height: 1.6;
        }

        .apprenti-card a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--ap-primary);
            font-size: .9rem;
            font-weight: 800;
            text-decoration: none;
        }

        .apprenti-card a:hover {
            color: #0c3f70;
            text-decoration: underline;
        }

        .apprenti-info {
            height: 100%;
            padding: 25px;
            background: #fff;
            border: 1px solid var(--ap-border);
            border-radius: 18px;
            box-shadow: 0 5px 18px rgba(31,67,105,.045);
        }

        .apprenti-data {
            height: 100%;
            padding: 15px;
            background: #f7faff;
            border: 1px solid #edf2f8;
            border-radius: 13px;
        }

        .apprenti-label {
            margin-bottom: 7px;
            color: var(--ap-muted);
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .35px;
        }

        .apprenti-value {
            overflow-wrap: anywhere;
            color: var(--ap-dark);
            font-size: .98rem;
            font-weight: 800;
        }

        .apprenti-profile-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            margin-bottom: 15px;
            border-radius: 16px;
            background: #eaf4ff;
            color: var(--ap-primary);
            font-size: 25px;
        }

        .apprenti-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 19px;
            border: 0;
            border-radius: 10px;
            background: var(--ap-primary);
            color: #fff !important;
            font-weight: 700;
            text-decoration: none;
            transition: background .2s ease, transform .2s ease;
        }

        .apprenti-btn:hover {
            background: #0d477c;
            transform: translateY(-2px);
        }

        .apprenti-notification-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--ap-primary);
            font-weight: 700;
            text-decoration: none;
        }

        .apprenti-notification-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 767px) {
            .apprenti-hero {
                padding: 25px 21px;
                border-radius: 17px;
            }

            .apprenti-info {
                padding: 19px;
            }

            .apprenti-card {
                min-height: auto;
            }

            .apprenti-card p {
                min-height: auto;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .apprenti-card,
            .apprenti-btn {
                transition: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="apprenti-page">

    {% include 'espace_apprenti/_menu.html.twig' %}

    <div class="container-fluid py-3">

        <section class="apprenti-hero mb-4">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <div class="eyebrow mb-3">E2C-MENAET · Espace personnel de formation</div>
                    <h1 class="mb-3 text-white">
                        Bienvenue {{ candidat.prenoms }} {{ candidat.nom }} !
                    </h1>
                    <p class="mb-0">
                        Votre espace personnel vous permet de suivre votre parcours,
                        de consulter vos rendez-vous et de rester informé de votre accompagnement.
                    </p>
                </div>
                <div class="col-lg-3 text-lg-end mt-4 mt-lg-0">
                    <span class="apprenti-hero-badge">
                        <span aria-hidden="true">●</span> Espace apprenti
                    </span>
                </div>
            </div>
        </section>

        <div class="apprenti-section-heading">
            <span class="heading-icon" aria-hidden="true">▦</span>
            <h2>Mon espace de formation</h2>
        </div>

        <div class="row g-3 mb-4">

            <div class="col-sm-6 col-xl-3">
                <div class="apprenti-card">
                    <div class="apprenti-card-icon" aria-hidden="true">▣</div>
                    <h3>Mes rendez-vous</h3>
                    <p>Retrouvez les rendez-vous programmés dans le cadre de votre suivi.</p>
                    <a href="{{ path('apprenti_rendez_vous') }}">
                        Consulter mes rendez-vous <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="apprenti-card">
                    <div class="apprenti-card-icon" aria-hidden="true">◎</div>
                    <h3>Mon parcours</h3>
                    <p>Suivez les différentes étapes de votre parcours de formation.</p>
                    <a href="{{ path('apprenti_parcours') }}">
                        Voir mon parcours <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="apprenti-card">
                    <div class="apprenti-card-icon" aria-hidden="true">▤</div>
                    <h3>Mes évaluations</h3>
                    <p>Consultez les évaluations enregistrées dans votre dossier.</p>
                    <a href="{{ path('apprenti_evaluations') }}">
                        Voir mes évaluations <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="apprenti-card">
                    <div class="apprenti-card-icon" aria-hidden="true">♧</div>
                    <h3>Mon accompagnement</h3>
                    <p>Retrouvez les informations relatives à votre accompagnement.</p>
                    <a href="{{ path('apprenti_accompagnement') }}">
                        Accéder au suivi <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>

        </div>

        <div class="apprenti-section-heading mt-4">
            <span class="heading-icon" aria-hidden="true">◈</span>
            <h2>Mes informations personnelles</h2>
        </div>

        <div class="row g-3">

            <div class="col-lg-7">
                <section class="apprenti-info">
                    <h3 class="h5 fw-bold mb-4">Ma situation actuelle</h3>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="apprenti-data">
                                <div class="apprenti-label">Numéro de dossier</div>
                                <div class="apprenti-value">
                                    {{ candidat.numero|default('Non renseigné') }}
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="apprenti-data">
                                <div class="apprenti-label">Métier</div>
                                <div class="apprenti-value">
                                    {{ candidat.metier|default('Non renseigné') }}
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="apprenti-data">
                                <div class="apprenti-label">Statut du dossier</div>
                                <div class="apprenti-value">
                                    {{ candidat.statut|default('Non renseigné') }}
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="apprenti-data">
                                <div class="apprenti-label">Téléphone</div>
                                <div class="apprenti-value">
                                    {{ candidat.telephone|default('Non renseigné') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-lg-5">
                <section class="apprenti-info">
                    <div class="apprenti-profile-icon" aria-hidden="true">♙</div>
                    <h3 class="h5 fw-bold mb-2">Mon espace personnel</h3>
                    <p class="text-secondary mb-4">
                        Consultez vos informations personnelles et vérifiez
                        qu'elles sont correctement renseignées.
                    </p>

                    <a href="{{ path('apprenti_profil') }}" class="apprenti-btn">
                        Consulter mon profil <span aria-hidden="true">→</span>
                    </a>

                    <hr class="my-4">

                    <a href="{{ path('apprenti_notifications') }}"
                       class="apprenti-notification-link">
                        <span aria-hidden="true">♧</span>
                        Consulter mes notifications <span aria-hidden="true">→</span>
                    </a>
                </section>
            </div>

        </div>
    </div>
</div>
{% endblock %}