{% extends 'base.html.twig' %}

{% block title %}Créer un compte | E2C-MENAET{% endblock %}

{% block body %}
<div class="account-shell">

    <section class="account-presentation">
        <div class="account-brand">
            <img src="{{ asset('images/logo DAIP.png') }}" alt="Logo DAIP">
            <div>
                <span class="account-brand-title">E2C-MENAET</span>
                <span class="account-brand-subtitle">Plateforme de gestion et de suivi</span>
            </div>
        </div>

        <div class="account-presentation-content">
            <span class="account-kicker">ESPACE UTILISATEUR</span>
            <h1>Rejoignez la plateforme E2C-MENAET</h1>
            <p>
                Demandez la création de votre espace personnel pour accéder
                aux services de la plateforme de formation, d’apprentissage
                et d’insertion professionnelle.
            </p>

            <div class="account-benefits">
                <div class="account-benefit">
                    <span class="account-benefit-number">01</span>
                    <div>
                        <strong>Une demande simplifiée</strong>
                        <span>Renseignez vos informations en quelques étapes.</span>
                    </div>
                </div>

                <div class="account-benefit">
                    <span class="account-benefit-number">02</span>
                    <div>
                        <strong>Un accès sécurisé</strong>
                        <span>Vos informations sont protégées par la plateforme.</span>
                    </div>
                </div>

                <div class="account-benefit">
                    <span class="account-benefit-number">03</span>
                    <div>
                        <strong>Une validation administrative</strong>
                        <span>Votre accès est activé après vérification par un administrateur.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="account-presentation-footer">
            <span>Former – Accompagner – Insérer</span>
            <span>DAIP | E2C-MENAET</span>
        </div>
    </section>

    <section class="account-form-section">
        <div class="account-form-container">

            <a class="account-back-link" href="{{ path('daip_accueil') }}">
                <span aria-hidden="true">←</span> Retour à l’accueil
            </a>

            <div class="account-form-heading">
                <span class="account-kicker account-kicker-blue">CRÉATION DE COMPTE</span>
                <h2>Créer mon espace</h2>
                <p>Renseignez les informations ci-dessous pour soumettre votre demande.</p>
            </div>

            {% for message in app.flashes('danger') %}
                <div class="alert alert-danger account-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('warning') %}
                <div class="alert alert-warning account-alert" role="alert">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="account-info">
                <span class="account-info-icon" aria-hidden="true">i</span>
                <div>
                    <strong>Votre demande sera vérifiée</strong>
                    <p>
                        La création de votre compte ne donne pas immédiatement
                        accès à la plateforme. Un administrateur doit d’abord
                        valider votre demande.
                    </p>
                </div>
            </div>

            <form method="post"
                  action="{{ path('public_compte_creer') }}"
                  class="account-form"
                  autocomplete="on">

                <input type="hidden" name="_token"
                       value="{{ csrf_token('creation_compte_public') }}">

                <div class="account-section-label">
                    <span>01</span>
                    <div>
                        <strong>Informations personnelles</strong>
                        <small>Les champs marqués d’un astérisque sont obligatoires.</small>
                    </div>
                </div>

                <div class="account-fields-grid">
                    <div class="account-field">
                        <label for="nom">Nom <span>*</span></label>
                        <input type="text" id="nom" name="nom"
                               value="{{ app.request.request.get('nom', '') }}"
                               maxlength="120" autocomplete="family-name"
                               placeholder="Votre nom" required>
                    </div>

                    <div class="account-field">
                        <label for="prenoms">Prénoms <span>*</span></label>
                        <input type="text" id="prenoms" name="prenoms"
                               value="{{ app.request.request.get('prenoms', '') }}"
                               maxlength="120" autocomplete="given-name"
                               placeholder="Vos prénoms" required>
                    </div>

                    <div class="account-field account-field-full">
                        <label for="email">Adresse e-mail <span>*</span></label>
                        <input type="email" id="email" name="email"
                               value="{{ app.request.request.get('email', '') }}"
                               maxlength="180" autocomplete="email"
                               placeholder="exemple@domaine.ci" required>
                        <small>Utilisez une adresse e-mail valide et accessible.</small>
                    </div>

                    <div class="account-field account-field-full">
                        <label for="telephone">Téléphone</label>
                        <input type="tel" id="telephone" name="telephone"
                               value="{{ app.request.request.get('telephone', '') }}"
                               maxlength="30" autocomplete="tel"
                               placeholder="Ex. : 07 00 00 00 00">
                    </div>
                </div>

                <div class="account-section-label account-section-password">
                    <span>02</span>
                    <div>
                        <strong>Sécurisation du compte</strong>
                        <small>Choisissez un mot de passe personnel et confidentiel.</small>
                    </div>
                </div>

                <div class="account-fields-grid">
                    <div class="account-field account-field-full">
                        <label for="password">Mot de passe <span>*</span></label>
                        <div class="account-password-wrap">
                            <input type="password" id="password" name="password"
                                   minlength="12" autocomplete="new-password"
                                   placeholder="12 caractères minimum" required>
                            <button type="button" class="account-password-toggle"
                                    data-password-target="password"
                                    aria-label="Afficher le mot de passe">
                                Afficher
                            </button>
                        </div>
                        <small>Votre mot de passe doit contenir au moins 12 caractères.</small>
                    </div>

                    <div class="account-field account-field-full">
                        <label for="confirmation">Confirmer le mot de passe <span>*</span></label>
                        <div class="account-password-wrap">
                            <input type="password" id="confirmation" name="confirmation"
                                   minlength="12" autocomplete="new-password"
                                   placeholder="Saisissez à nouveau votre mot de passe" required>
                            <button type="button" class="account-password-toggle"
                                    data-password-target="confirmation"
                                    aria-label="Afficher la confirmation du mot de passe">
                                Afficher
                            </button>
                        </div>
                    </div>
                </div>

                <button type="submit" class="account-submit">
                    Soumettre ma demande
                    <span aria-hidden="true">→</span>
                </button>

                <p class="account-secure-note">
                    <span aria-hidden="true">✓</span>
                    Vos informations sont transmises de manière sécurisée.
                </p>
            </form>

            <div class="account-login-link">
                Vous possédez déjà un compte ?
                <a href="{{ path('app_login') }}">Se connecter</a>
            </div>

            <div class="account-bottom-note">
                E2C-MENAET · Plateforme institutionnelle de formation et d’insertion
            </div>
        </div>
    </section>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-password-target]').forEach(function (button) {
        button.addEventListener('click', function () {
            const input = document.getElementById(button.dataset.passwordTarget);

            if (!input) {
                return;
            }

            const visible = input.type === 'password';
            input.type = visible ? 'text' : 'password';
            button.textContent = visible ? 'Masquer' : 'Afficher';
            button.setAttribute(
                'aria-label',
                visible ? 'Masquer le mot de passe' : 'Afficher le mot de passe'
            );
        });
    });
});
</script>
{% endblock %}
