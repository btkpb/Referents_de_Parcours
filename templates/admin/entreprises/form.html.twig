{% extends 'base.html.twig' %}

{% set urlFormulaire = edition
    ? path('admin_entreprises_edit', {id: entreprise.id})
    : path('admin_entreprises_new')
%}

{% block title %}{{ edition ? 'Modifier une entreprise' : 'Nouvelle entreprise' }}{% endblock %}

{% block body %}
<style>
    .entreprise-form-page {
        --daip-blue: #174c83;
        --daip-dark: #10365f;
        --daip-light: #edf4fb;
        color: #263445;
        padding-bottom: 35px;
    }

    .entreprise-form-page .page-header {
        background: linear-gradient(120deg, var(--daip-dark), #2874b9);
        color: #fff;
        border-radius: 16px;
        padding: 28px 32px;
        margin-bottom: 26px;
        box-shadow: 0 8px 22px rgba(16, 54, 95, .16);
    }

    .entreprise-form-page .page-header h1 {
        color: #fff !important;
        font-size: clamp(1.45rem, 3vw, 2rem);
        font-weight: 750;
        margin: 8px 0;
    }

    .entreprise-form-page .page-header p {
        color: rgba(255,255,255,.82);
        margin: 0;
    }

    .entreprise-form-page .back-link {
        color: #fff;
        text-decoration: none;
        font-size: .9rem;
        opacity: .9;
    }

    .entreprise-form-page .back-link:hover {
        opacity: 1;
        text-decoration: underline;
    }

    .entreprise-form-page .section-card {
        background: #fff;
        border: 1px solid #e5ebf2;
        border-radius: 13px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(28, 48, 73, .045);
    }

    .entreprise-form-page .section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px 22px;
        background: #f8fafc;
        border-bottom: 1px solid #e8edf3;
    }

    .entreprise-form-page .section-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border-radius: 11px;
        color: var(--daip-blue);
        background: #e5effa;
        font-size: 1.15rem;
    }

    .entreprise-form-page .section-heading h2 {
        font-size: 1.02rem;
        font-weight: 700;
        margin: 0;
        color: #20364d;
    }

    .entreprise-form-page .section-heading p {
        margin: 3px 0 0;
        color: #718096;
        font-size: .82rem;
    }

    .entreprise-form-page .section-body {
        padding: 23px;
    }

    .entreprise-form-page .form-label {
        font-size: .88rem;
        font-weight: 650;
        color: #34465a;
        margin-bottom: 7px;
    }

    .entreprise-form-page .form-control {
        min-height: 44px;
        border: 1px solid #d8e0e9;
        border-radius: 8px;
        font-size: .92rem;
        padding: 10px 12px;
        background-color: #fff;
    }

    .entreprise-form-page .form-control:focus {
        border-color: #4b8bc8;
        box-shadow: 0 0 0 .2rem rgba(40, 116, 185, .12);
    }

    .entreprise-form-page .form-control[type="file"] {
        padding: 8px;
        min-height: 46px;
    }

    .entreprise-form-page .form-hint {
        display: block;
        margin-top: 6px;
        color: #77869a;
        font-size: .78rem;
    }

    .entreprise-form-page .file-panel {
        height: 100%;
        padding: 16px;
        border: 1px dashed #cbd7e4;
        border-radius: 10px;
        background: #fbfdff;
    }

    .entreprise-form-page .current-file {
        display: inline-block;
        margin-top: 10px;
        font-size: .84rem;
        font-weight: 600;
        color: var(--daip-blue);
        text-decoration: none;
    }

    .entreprise-form-page .current-file:hover {
        text-decoration: underline;
    }

    .entreprise-form-page .form-actions {
        position: sticky;
        bottom: 0;
        z-index: 10;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 15px 18px;
        margin-top: 24px;
        background: rgba(255,255,255,.97);
        border: 1px solid #e3e9f0;
        border-radius: 12px;
        box-shadow: 0 -4px 18px rgba(28,48,73,.06);
        backdrop-filter: blur(8px);
    }

    .entreprise-form-page .btn-save {
        background: var(--daip-blue);
        color: #fff;
        border: 1px solid var(--daip-blue);
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 650;
    }

    .entreprise-form-page .btn-save:hover {
        background: var(--daip-dark);
        color: #fff;
    }

    .entreprise-form-page .btn-cancel {
        border-radius: 8px;
        padding: 11px 19px;
        font-weight: 600;
    }

    .entreprise-form-page .required-note {
        font-size: .82rem;
        color: #718096;
    }

    @media (max-width: 576px) {
        .entreprise-form-page .page-header {
            padding: 22px 18px;
        }

        .entreprise-form-page .section-body {
            padding: 17px;
        }

        .entreprise-form-page .section-heading {
            padding: 15px 17px;
        }

        .entreprise-form-page .form-actions {
            position: static;
        }

        .entreprise-form-page .form-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid px-lg-4 entreprise-form-page">

    <div class="page-header">
        <a href="{{ path('admin_entreprises_index') }}" class="back-link">
            <i class="bi bi-arrow-left me-1"></i> Retour aux entreprises
        </a>

        <div class="mt-3">
            <div class="small fw-semibold text-white-50">
                DAIP / GESTION ADMINISTRATIVE
            </div>
            <h1>
                <i class="bi bi-buildings me-2"></i>
                {{ edition ? 'Modifier une entreprise' : 'Nouvelle entreprise d’accueil' }}
            </h1>
            <p>
                {{ edition
                    ? 'Actualisez les informations de cette structure d’accueil.'
                    : 'Enregistrez une nouvelle structure partenaire pour l’accueil des apprentis.'
                }}
            </p>
        </div>
    </div>

    {% if erreur %}
        <div class="alert alert-danger border-0 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{ erreur }}
        </div>
    {% endif %}

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div class="required-note">
            <span class="text-danger fw-bold">*</span>
            Champ obligatoire
        </div>
        <div class="small text-muted">
            <i class="bi bi-shield-check me-1"></i>
            Les informations sont enregistrées dans le dossier de l’entreprise.
        </div>
    </div>

    <form method="post" action="{{ urlFormulaire }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('entreprise_form')}}">

        {# IDENTIFICATION #}
        <section class="section-card">
            <div class="section-heading">
                <span class="section-icon"><i class="bi bi-building"></i></span>
                <div>
                    <h2>Identification de l’entreprise</h2>
                    <p>Informations générales sur la structure d’accueil</p>
                </div>
            </div>
            <div class="section-body">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Raison sociale <span class="text-danger">*</span></label>
                        <input type="text" name="raisonSociale" class="form-control"
                               required maxlength="180" autocomplete="organization"
                               placeholder="Nom officiel de l’entreprise"
                               value="{{ entreprise.raisonSociale }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Sigle</label>
                        <input type="text" name="sigle" class="form-control"
                               maxlength="80" placeholder="Ex. : SARL, SA..."
                               value="{{ entreprise.sigle }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Secteur d’activité</label>
                        <input type="text" name="secteurActivite" class="form-control"
                               maxlength="160" placeholder="Ex. : Bâtiment et travaux publics"
                               value="{{ entreprise.secteurActivite }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ville</label>
                        <input type="text" name="ville" class="form-control"
                               maxlength="120" placeholder="Ville d’implantation"
                               value="{{ entreprise.ville }}">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Adresse géographique</label>
                        <input type="text" name="adresse" class="form-control"
                               maxlength="255" placeholder="Commune, quartier, rue, repère..."
                               value="{{ entreprise.adresse }}">
                    </div>
                </div>
            </div>
        </section>

        {# COORDONNEES #}
        <section class="section-card">
            <div class="section-heading">
                <span class="section-icon"><i class="bi bi-telephone"></i></span>
                <div>
                    <h2>Coordonnées de l’entreprise</h2>
                    <p>Moyens de contact officiels de la structure</p>
                </div>
            </div>
            <div class="section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Téléphone principal</label>
                        <input type="tel" name="telephone" class="form-control"
                               maxlength="30" autocomplete="tel"
                               placeholder="Ex. : 07 00 00 00 00"
                               value="{{ entreprise.telephone }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone secondaire</label>
                        <input type="tel" name="telephoneSecondaire" class="form-control"
                               maxlength="30" placeholder="Numéro complémentaire"
                               value="{{ entreprise.telephoneSecondaire }}">
                    </div>
                    <div class="col-12">
                        <label class="form-label">Adresse électronique</label>
                        <input type="email" name="email" class="form-control"
                               maxlength="180" autocomplete="email"
                               placeholder="contact@entreprise.ci"
                               value="{{ entreprise.email }}">
                    </div>
                </div>
            </div>
        </section>

        {# RESPONSABLE #}
        <section class="section-card">
            <div class="section-heading">
                <span class="section-icon"><i class="bi bi-person-badge"></i></span>
                <div>
                    <h2>Responsable de l’entreprise</h2>
                    <p>Personne représentant ou dirigeant la structure</p>
                </div>
            </div>
            <div class="section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom et prénoms</label>
                        <input type="text" name="nomResponsable" class="form-control"
                               maxlength="160" placeholder="Nom complet du responsable"
                               value="{{ entreprise.nomResponsable }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fonction</label>
                        <input type="text" name="fonctionResponsable" class="form-control"
                               maxlength="120" placeholder="Ex. : Directeur général"
                               value="{{ entreprise.fonctionResponsable }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <input type="tel" name="telephoneResponsable" class="form-control"
                               maxlength="30" placeholder="Téléphone du responsable"
                               value="{{ entreprise.telephoneResponsable }}">
                    </div>
                </div>
            </div>
        </section>

        {# TUTEUR #}
        <section class="section-card">
            <div class="section-heading">
                <span class="section-icon"><i class="bi bi-person-workspace"></i></span>
                <div>
                    <h2>Maître de stage / Tuteur en entreprise</h2>
                    <p>Personne chargée de l’encadrement de l’apprenti dans l’entreprise</p>
                </div>
            </div>
            <div class="section-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom et prénoms</label>
                        <input type="text" name="nomTuteur" class="form-control"
                               maxlength="160" placeholder="Nom complet du maître de stage"
                               value="{{ entreprise.nomTuteur }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Fonction</label>
                        <input type="text" name="fonctionTuteur" class="form-control"
                               maxlength="120" placeholder="Fonction dans l’entreprise"
                               value="{{ entreprise.fonctionTuteur }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Téléphone</label>
                        <input type="tel" name="telephoneTuteur" class="form-control"
                               maxlength="30" placeholder="Téléphone du maître de stage"
                               value="{{ entreprise.telephoneTuteur }}">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Adresse électronique</label>
                        <input type="email" name="emailTuteur" class="form-control"
                               maxlength="180" placeholder="Adresse électronique du tuteur"
                               value="{{ entreprise.emailTuteur }}">
                    </div>
                </div>
            </div>
        </section>

        {# DOCUMENTS #}
        <section class="section-card">
            <div class="section-heading">
                <span class="section-icon"><i class="bi bi-images"></i></span>
                <div>
                    <h2>Logo et cachet de l’entreprise</h2>
                    <p>Documents visuels utiles à l’identification et au suivi administratif</p>
                </div>
            </div>
            <div class="section-body">
                <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Formats acceptés : JPG, JPEG, PNG et WEBP. Taille maximale : 5 Mo par image.
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="file-panel">
                            <label class="form-label">
                                <i class="bi bi-image me-1 text-primary"></i> Logo de l’entreprise
                            </label>
                            <input type="file" name="logo" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp">
                            <span class="form-hint">Sélectionnez le logo officiel de la structure.</span>
                            {% if edition and entreprise.logoFichier %}
                                <a class="current-file"
                                   href="{{ path('admin_entreprises_fichier', {id: entreprise.id, type: 'logo'}) }}"
                                   target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-eye me-1"></i> Consulter le logo actuel
                                </a>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="file-panel">
                            <label class="form-label">
                                <i class="bi bi-patch-check me-1 text-primary"></i> Cachet de l’entreprise
                            </label>
                            <input type="file" name="cachet" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp">
                            <span class="form-hint">Sélectionnez une image lisible du cachet.</span>
                            {% if edition and entreprise.cachetFichier %}
                                <a class="current-file"
                                   href="{{ path('admin_entreprises_fichier', {id: entreprise.id, type: 'cachet'}) }}"
                                   target="_blank" rel="noopener noreferrer">
                                    <i class="bi bi-eye me-1"></i> Consulter le cachet actuel
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ACTIONS #}
        <div class="form-actions">
            <div class="small text-muted">
                <i class="bi bi-check-circle me-1 text-success"></i>
                Vérifiez les informations avant l’enregistrement.
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('admin_entreprises_index') }}"
                   class="btn btn-outline-secondary btn-cancel">
                    <i class="bi bi-x-circle me-1"></i> Annuler
                </a>
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check2-circle me-1"></i>
                    {{ edition ? 'Enregistrer les modifications' : 'Enregistrer l’entreprise' }}
                </button>
            </div>
        </div>
    </form>
</div>
{% endblock %}
