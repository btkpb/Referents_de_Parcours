{% extends 'base.html.twig' %}

{% block title %}Nouveau placement en entreprise{% endblock %}

{% block body %}
<style>
.placement-form-page { color:#263445;max-width:1100px;margin:auto; }
.placement-form-page .page-header {
    background:linear-gradient(120deg,#10365f,#2874b9);
    color:#fff;border-radius:16px;padding:27px 30px;margin-bottom:24px;
    box-shadow:0 8px 22px rgba(16,54,95,.16);
}
.placement-form-page .page-header h1 { color:#fff!important;font-size:1.65rem;font-weight:750;margin:8px 0; }
.placement-form-page .page-header p { color:rgba(255,255,255,.82);margin:0; }
.placement-form-page .back-link { color:#fff;text-decoration:none;font-size:.9rem; }
.placement-form-page .section-card { background:#fff;border:1px solid #e5ebf2;border-radius:13px;margin-bottom:20px;overflow:hidden;box-shadow:0 4px 14px rgba(28,48,73,.045); }
.placement-form-page .section-heading { padding:17px 22px;background:#f8fafc;border-bottom:1px solid #e8edf3; }
.placement-form-page .section-heading h2 { font-size:1rem;font-weight:750;margin:0;color:#20364d; }
.placement-form-page .section-body { padding:23px; }
.placement-form-page .form-label { color:#4c5d70;font-size:.86rem;font-weight:650;margin-bottom:7px; }
.placement-form-page .form-control,.placement-form-page .form-select { min-height:44px;border:1px solid #dce4ed;border-radius:8px; }
.placement-form-page .form-control:focus,.placement-form-page .form-select:focus { border-color:#5592ca;box-shadow:0 0 0 .2rem rgba(40,112,180,.12); }
.placement-form-page .help-text { color:#778493;font-size:.8rem;margin-top:6px; }
.placement-form-page .actions { position:sticky;bottom:12px;background:rgba(255,255,255,.96);padding:14px;border:1px solid #e5ebf2;border-radius:12px;box-shadow:0 4px 15px rgba(20,40,60,.08); }
</style>

<div class="container-fluid placement-form-page py-4">
    <div class="page-header">
        <a href="{{ path('admin_placements_index') }}" class="back-link"><i class="bi bi-arrow-left me-1"></i> Retour aux placements</a>
        <h1><i class="bi bi-building-add me-2"></i>Nouveau placement en entreprise</h1>
        <p>Enregistrer l’affectation d’un apprenti admis auprès d’une entreprise d’accueil</p>
    </div>

    {% if erreurs is not empty %}
        <div class="alert alert-danger">
            <strong>Veuillez corriger les points suivants :</strong>
            <ul class="mb-0 mt-2">
                {% for erreur in erreurs %}<li>{{ erreur }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    {% if candidats is empty %}
        <div class="alert alert-warning">
            Aucun apprenti admis disponible pour un nouveau placement.
            Les apprentis ayant déjà un placement en cours ne sont pas proposés.
        </div>
    {% endif %}

    {% if entreprises is empty %}
        <div class="alert alert-warning">
            Aucune entreprise active n’est disponible. Activez ou enregistrez une entreprise avant de créer un placement.
        </div>
    {% endif %}

    <form method="post" action="{{ path('admin_placements_new') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('placement_nouveau') }}">

        <div class="section-card">
            <div class="section-heading"><h2><i class="bi bi-person-badge me-2 text-primary"></i>Apprenti à placer</h2></div>
            <div class="section-body">
                <label class="form-label" for="candidat">Apprenti admis <span class="text-danger">*</span></label>
                <select class="form-select" id="candidat" name="candidat" required>
                    <option value="">Sélectionner un apprenti</option>
                    {% for candidat in candidats %}
                        <option value="{{ candidat.id }}" {{ app.request.request.get('candidat') == candidat.id ? 'selected' }}>
                            {{ candidat.nom }} {{ candidat.prenoms }} — {{ candidat.numero }}
                        </option>
                    {% endfor %}
                </select>
                <div class="help-text">Seuls les candidats ayant une décision d’admission exactement égale à ADM​IS et sans placement en cours sont affichés.</div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-heading"><h2><i class="bi bi-buildings me-2 text-primary"></i>Entreprise et chantier</h2></div>
            <div class="section-body">
                <div class="mb-3">
                    <label class="form-label" for="entreprise">Entreprise d’accueil <span class="text-danger">*</span></label>
                    <select class="form-select" id="entreprise" name="entreprise" required>
                        <option value="">Sélectionner une entreprise active</option>
                        {% for entreprise in entreprises %}
                            <option value="{{ entreprise.id }}" {{ app.request.request.get('entreprise') == entreprise.id ? 'selected' }}>
                                {{ entreprise.raisonSociale }}{% if entreprise.ville %} — {{ entreprise.ville }}{% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="form-label" for="chantier">Chantier (facultatif)</label>
                    <select class="form-select" id="chantier" name="chantier">
                        <option value="">Aucun chantier précisé</option>
                        {% for chantier in chantiers %}
                            <option value="{{ chantier.id }}" {{ app.request.request.get('chantier') == chantier.id ? 'selected' }}>
                                {{ chantier.nom }} — {{ chantier.localisation }}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="help-text">Les chantiers actifs sont proposés. Leur rattachement à l’entreprise n’est pas contrôlé automatiquement, car le catalogue actuel utilise un nom d’entreprise en texte libre.</div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-heading"><h2><i class="bi bi-calendar-event me-2 text-primary"></i>Dates et observations</h2></div>
            <div class="section-body">
                <div class="mb-3">
                    <label class="form-label" for="dateDebut">Date de début du placement <span class="text-danger">*</span></label>
                    <input type="date" class="form-control" id="dateDebut" name="dateDebut"
                           value="{{ app.request.request.get('dateDebut', dateDebutDefaut) }}" required>
                </div>
                <div>
                    <label class="form-label" for="observations">Observations</label>
                    <textarea class="form-control" id="observations" name="observations" rows="4" maxlength="10000"
                              placeholder="Précisions utiles sur le placement...">{{ app.request.request.get('observations') }}</textarea>
                </div>
            </div>
        </div>

        <div class="actions d-flex flex-wrap justify-content-between gap-2">
            <a href="{{ path('admin_placements_index') }}" class="btn btn-outline-secondary">Annuler</a>
            <button type="submit" class="btn btn-primary" {{ candidats is empty or entreprises is empty ? 'disabled' }}>
                <i class="bi bi-check-circle me-1"></i> Enregistrer le placement
            </button>
        </div>
    </form>
</div>
{% endblock %}