{% extends 'base.html.twig' %}

{% block title %}Quotas par métier - E2C{% endblock %}

{% block body %}
<div class="container" style="max-width: 950px;">
    <div class="mb-4">
        <h1 class="h3">Quotas par métier</h1>
        <p class="text-muted mb-1">{{ campagne.nom }}</p>
        <p class="small text-muted mb-0">
            Quota global calculé automatiquement :
            <strong>{{ campagne.quotaGlobal|default(0) }}</strong>
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token('quotas_campagne_' ~ campagne.id) }}">

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Métier</th>
                                <th>Secteur</th>
                                <th>Statut catalogue</th>
                                <th style="width: 180px;">Quota prévu</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for metier in metiers %}
                            <tr>
                                <td class="fw-semibold">{{ metier.nom }}</td>
                                <td>{{ metier.secteur }}</td>
                                <td>
                                    {% if metier.actif %}
                                        <span class="badge bg-success">Actif</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Inactif</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <input class="form-control" type="number" min="0"
                                           name="quotas[{{ metier.id }}]"
                                           value="{{ metier.quota }}" required>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted">
                                    Aucun métier dans le catalogue.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-info">
                    Le quota global est calculé automatiquement à partir de la somme des quotas attribués aux différents métiers. Il sera actualisé après l’enregistrement.
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-primary" type="submit">Enregistrer les quotas</button>
                    <a class="btn btn-outline-secondary" href="{{ path('admin_campagnes_index') }}">Retour aux campagnes</a>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}