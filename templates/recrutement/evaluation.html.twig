{% extends 'base.html.twig' %}

{% block body %}
<style>
    .jury-evaluation {
        max-width: 1050px;
        margin: 0 auto;
    }

    .jury-evaluation .page-title {
        color: #174A7E;
        font-weight: 800;
    }

    .jury-evaluation .candidate-card,
    .jury-evaluation .rubric-card {
        border: 1px solid #DCE5EF;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(23, 74, 126, .06);
        background: #fff;
    }

    .jury-evaluation .rubric-card {
        margin-bottom: 22px;
    }

    .jury-evaluation .rubric-header {
        background: #F0F5FA;
        border-bottom: 1px solid #DCE5EF;
        padding: 17px 20px;
    }

    .jury-evaluation .rubric-title {
        color: #174A7E;
        font-size: 1.08rem;
        font-weight: 800;
        margin: 0;
        line-height: 1.5;
    }

    .jury-evaluation .rubric-body {
        padding: 20px;
    }

    .jury-evaluation .evaluation-question {
        color: #334155;
        font-size: .98rem;
        font-weight: 400;
        line-height: 1.7;
        margin-bottom: 13px;
    }

    .jury-evaluation .evaluation-question strong {
        color: #26384A;
        font-weight: 700;
    }

    .jury-evaluation .branch-title {
        color: #174A7E;
        font-weight: 700;
        font-size: .98rem;
        margin: 18px 0 10px;
    }

    .jury-evaluation .score-box {
        margin-top: 22px;
        padding: 16px;
        background: #EEF5FC;
        border: 1px solid #C9DCEC;
        border-radius: 10px;
    }

    .jury-evaluation .score-box label {
        color: #174A7E;
        font-weight: 700;
    }

    .jury-evaluation .score-input {
        max-width: 180px;
        font-weight: 700;
        border: 1px solid #9BB9D5;
    }

    .jury-evaluation .total-box {
        background: #174A7E;
        color: #fff;
        border-radius: 12px;
        padding: 18px 22px;
    }

    .jury-evaluation .total-box strong {
        font-size: 1.05rem;
    }

    .jury-evaluation .total-value {
        font-size: 1.8rem;
        font-weight: 800;
    }

    .jury-evaluation .section-label {
        color: #174A7E;
        font-weight: 800;
    }

    @media (max-width: 576px) {
        .jury-evaluation .rubric-body {
            padding: 15px;
        }

        .jury-evaluation .rubric-header {
            padding: 15px;
        }

        .jury-evaluation .score-input {
            max-width: 100%;
        }
    }
</style>

<div class="container py-4 jury-evaluation">
    <div class="mb-4">
        <h2 class="page-title mb-2">Évaluation du candidat par le jury</h2>
        <p class="text-muted mb-0">Grille officielle d'évaluation et de notation sur 40 points</p>
    </div>

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    <div class="candidate-card mb-4">
        <div class="p-3 px-4 border-bottom">
            <h5 class="section-label mb-0">Informations du candidat</h5>
        </div>
        <div class="p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <strong>Nom :</strong>
                    {{ entretien.candidat ? entretien.candidat.nom : 'Non renseigné' }}
                </div>
                <div class="col-md-6">
                    <strong>Prénoms :</strong>
                    {{ entretien.candidat ? entretien.candidat.prenoms : 'Non renseignés' }}
                </div>
                <div class="col-md-6">
                    <strong>Date de l'entretien :</strong>
                    {{ entretien.dateHeure ? entretien.dateHeure|date('d/m/Y à H:i') : 'Non renseignée' }}
                </div>
                <div class="col-md-6">
                    <strong>Lieu :</strong>
                    {{ entretien.lieu }}
                </div>
            </div>
        </div>
    </div>

    <div class="total-box d-flex justify-content-between align-items-center mb-4">
        <strong>Total de l'évaluation</strong>
        <div class="text-end">
            <span class="total-value" id="evaluation-total">0</span>
            <span class="fw-semibold"> / 40 points</span>
        </div>
    </div>

    <form method="post">
        <input type="hidden" name="_token"
               value="{{ csrf_token('evaluation_' ~ entretien.id) }}">

        {# RUBRIQUE 1 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">1) Identification du candidat : (note /3)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question">
                    <strong>Nom et prénoms :</strong> présentez-vous.
                </p>
                <p class="evaluation-question">
                    <strong>Situation matrimoniale :</strong> êtes-vous célibataire ? en concubinage ? marié(e) ?
                    Avez-vous des enfants ? Sont-ils scolarisés ? dans le cas contraire quel est le mode de garde ?
                </p>
                <p class="evaluation-question">
                    <strong>Métier choisi :</strong> quel métier avez-vous choisi pour le présent recrutement ?
                    que savez-vous de ce métier ?
                </p>

                <div class="score-box">
                    <label for="score_identification">Note attribuée à cette rubrique (sur 3 points)</label>
                    <input id="score_identification" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[identification]" min="0" max="3" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreIdentification') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 2 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">2) Motivation et disponibilité : (note /8)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question"><strong>a)</strong> Pourquoi voulez- vous exercer le métier choisi ?</p>
                <p class="evaluation-question"><strong>b)</strong> En cas d’offre d’emploi pendant la formation que feriez-vous ?</p>
                <p class="evaluation-question"><strong>c)</strong> Qu’est ce qui peut vous empêcher de commencer ou terminer la formation ?</p>
                <p class="evaluation-question"><strong>d)</strong> Quel est votre plus grand souhait à la fin de cette formation quand vous avez obtenu votre diplôme ?</p>

                <div class="score-box">
                    <label for="score_motivation">Note attribuée à cette rubrique (sur 8 points)</label>
                    <input id="score_motivation" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[motivation]" min="0" max="8" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreMotivation') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 3 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">3) Détection des freins sociaux : (note /15)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question"><strong>Logement :</strong> hébergé ? en location ? propriétaire ?</p>
                <p class="evaluation-question"><strong>Mobilité :</strong> quel moyen de transport utilisez-vous pour vos déplacements ?</p>
                <p class="evaluation-question">
                    <strong>Ressources :</strong> tout au long de la formation avec quelles ressources allez-vous subvenir à vos besoins ?
                    Avez-vous les moyens financiers pour vous déplacer durant les trois premiers mois de la formation ?
                </p>
                <p class="evaluation-question">
                    <strong>Santé :</strong> Avez-vous un problème de santé ? Vous empêcherait-il de suivre la formation ?
                </p>
                <p class="evaluation-question">
                    <strong>Niveau d’étude et expériences professionnelles :</strong>
                    bref résumé du parcours scolaire et professionnel pour vérifier les prérequis du métier ?
                </p>

                <div class="score-box">
                    <label for="score_freins">Note attribuée à cette rubrique (sur 15 points)</label>
                    <input id="score_freins" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[freins]" min="0" max="15" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreFreins') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 4 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">4) Sens de l’organisation : (note /2)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question"><strong>a)</strong> Comment procédez-vous quand vous avez plusieurs tâches à exécuter ?</p>
                <p class="evaluation-question"><strong>b)</strong> On vous demande de réaliser une tâche que vous ne maîtrisez pas encore. Comment réagissez-vous ?</p>

                <div class="score-box">
                    <label for="score_organisation">Note attribuée à cette rubrique (sur 2 points)</label>
                    <input id="score_organisation" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[organisation]" min="0" max="2" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreOrganisation') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 5 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">5) Sens de l’anticipation et de la réactivité, esprit d’initiative et ingéniosité : (note /2)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question">
                    Pouvez-vous me parler d’une situation où vous avez dû prendre une décision rapidement ?
                </p>

                <div class="score-box">
                    <label for="score_anticipation">Note attribuée à cette rubrique (sur 2 points)</label>
                    <input id="score_anticipation" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[anticipation]" min="0" max="2" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreAnticipation') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 6 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">6) Sens des relations humaines et travail en équipe : (note /2)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question">
                    <strong>a)</strong> Préférez-vous travailler seul ou en équipe ? Avez-vous déjà eu un conflit avec un collègue ?
                </p>
                <p class="evaluation-question">
                    <strong>b)</strong> Comment réagiriez-vous, si votre supérieur hiérarchique vous demande d’exécuter une tâche pour laquelle vous ne m’avez pas été formé ?
                </p>

                <div class="score-box">
                    <label for="score_relations">Note attribuée à cette rubrique (sur 2 points)</label>
                    <input id="score_relations" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[relations]" min="0" max="2" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreRelations') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 7 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">7) Projet, plan d’affaire ou entrepreneuriat : (note /4)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question">
                    <strong>a)</strong> Comment envisagez-vous votre insertion professionnelle : en créant votre propre activité ou en intégrant une structure existante ?
                </p>

                <div class="mt-3">
                    <h4 class="branch-title">Si auto-emploi</h4>
                    <p class="evaluation-question">
                        <strong>b)</strong> Avez-vous déjà pensé à une idée d'entreprise ou de projet que vous aimeriez développer ?
                    </p>
                    <p class="evaluation-question">
                        <strong>c)</strong> Quelles compétences ou quels soutiens pensez-vous nécessaires pour vous lancer dans l'entrepreneuriat ?
                    </p>
                </div>

                <div class="mt-3">
                    <h4 class="branch-title">Si emploi-salarié</h4>
                    <p class="evaluation-question">
                        <strong>d)</strong> Quels sont les avantages d’intégrer une structure existante plutôt que de créer sa propre activité ?
                    </p>
                </div>

                <div class="score-box">
                    <label for="score_projet">Note attribuée à cette rubrique (sur 4 points)</label>
                    <input id="score_projet" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[projet]" min="0" max="4" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreProjet') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 8 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">8) Première impression et communication non verbale (politesse, tenue vestimentaire) : (note /2)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question">À l’appréciation du recruteur</p>

                <div class="score-box">
                    <label for="score_premiereImpression">Note attribuée à cette rubrique (sur 2 points)</label>
                    <input id="score_premiereImpression" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[premiereImpression]" min="0" max="2" step="0.5"
                           required value="{{ attribute(evaluation, 'scorePremiereImpression') }}">
                </div>
            </div>
        </section>

        {# RUBRIQUE 9 #}
        <section class="rubric-card">
            <div class="rubric-header">
                <h3 class="rubric-title">9) Présentation orale (élocution fluide, clarté des propos) : (note /2)</h3>
            </div>
            <div class="rubric-body">
                <p class="evaluation-question">À l’appréciation du recruteur</p>

                <div class="score-box">
                    <label for="score_expressionOrale">Note attribuée à cette rubrique (sur 2 points)</label>
                    <input id="score_expressionOrale" class="form-control score-input evaluation-score"
                           type="number" name="evaluation[expressionOrale]" min="0" max="2" step="0.5"
                           required value="{{ attribute(evaluation, 'scoreExpressionOrale') }}">
                </div>
            </div>
        </section>

        <div class="alert alert-info">
            <strong>Barème :</strong> les notes peuvent être attribuées par demi-point.
            Le total maximal est de 40 points.
        </div>

        <div class="candidate-card p-4 mb-4">
            <div class="mb-4">
                <label class="form-label fw-bold section-label" for="decision">Avis du jury</label>
                <select class="form-select" id="decision" name="evaluation[decision]" required>
                    <option value="EN_ATTENTE" {{ evaluation.decision == 'EN_ATTENTE' ? 'selected' : '' }}>En attente</option>
                    <option value="FAVORABLE" {{ evaluation.decision == 'FAVORABLE' ? 'selected' : '' }}>Favorable</option>
                    <option value="DEFAVORABLE" {{ evaluation.decision == 'DEFAVORABLE' ? 'selected' : '' }}>Défavorable</option>
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label fw-bold section-label" for="observations">
                    Observations et recommandations du jury
                </label>
                <textarea id="observations" name="evaluation[observations]"
                          class="form-control" rows="4"
                          placeholder="Saisir les observations du jury...">{{ evaluation.observations }}</textarea>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <button type="submit" class="btn btn-primary btn-lg px-4">
                Enregistrer l’évaluation
            </button>
            <a href="{{ path('recruitment_interviews') }}" class="btn btn-outline-secondary btn-lg">
                Retour aux entretiens
            </a>
        </div>
    </form>
</div>

<script>
(function () {
    const notes = document.querySelectorAll('.evaluation-score');
    const affichage = document.getElementById('evaluation-total');

    if (!affichage) {
        return;
    }

    function calculerTotal() {
        let total = 0;

        notes.forEach(function (champ) {
            const valeur = parseFloat(champ.value);

            if (champ.value.trim() !== '' && Number.isFinite(valeur)) {
                total += valeur;
            }
        });

        affichage.textContent = Number.isInteger(total)
            ? total
            : total.toFixed(1);
    }

    notes.forEach(function (champ) {
        champ.addEventListener('input', calculerTotal);
        champ.addEventListener('change', calculerTotal);
    });

    calculerTotal();
})();
</script>
{% endblock %}