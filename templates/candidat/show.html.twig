{% extends 'base.html.twig' %}

{% block body %}
<style>
.e2c-dossier {
    --e2c-blue: #174a78;
    --e2c-blue-light: #eaf3fb;
    --e2c-gold: #d6a642;
    --e2c-text: #263445;
    --e2c-muted: #718096;
    color: var(--e2c-text);
    padding-bottom: 35px;
}
.e2c-dossier .dossier-hero {
    background: linear-gradient(120deg, #123b63 0%, #21649a 65%, #3c82b8 100%);
    color: #fff;
    border-radius: 18px;
    padding: 28px 30px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(20, 57, 91, .18);
}
.e2c-dossier .dossier-hero:after {
    content: "";
    position: absolute;
    width: 230px;
    height: 230px;
    border: 35px solid rgba(255,255,255,.07);
    border-radius: 50%;
    right: -65px;
    top: -100px;
}
.e2c-dossier .hero-label {
    color: #d9eafa;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
}
.e2c-dossier .hero-name {
    color: #FFFFFF !important;
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 800;
    margin: 5px 0 8px;
    letter-spacing: .2px;
}
.e2c-dossier .hero-meta {
    color: #e3eef8;
    font-size: .92rem;
}
.e2c-dossier .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #e4f6eb;
    color: #17643b;
    padding: 7px 15px;
    border-radius: 30px;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .5px;
}
.e2c-dossier .hero-photo {
    width: 116px;
    height: 138px;
    object-fit: cover;
    border: 4px solid rgba(255,255,255,.9);
    border-radius: 13px;
    box-shadow: 0 5px 18px rgba(0,0,0,.2);
    background: #fff;
}
.e2c-dossier .hero-photo-placeholder {
    width: 116px;
    height: 138px;
    border: 2px dashed rgba(255,255,255,.65);
    border-radius: 13px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(255,255,255,.12);
}
.e2c-dossier .dossier-card {
    background: #fff;
    border: 1px solid #e5ebf1;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(25, 55, 85, .055);
    height: 100%;
}
.e2c-dossier .dossier-card-header {
    padding: 17px 21px;
    border-bottom: 1px solid #edf1f5;
    display: flex;
    align-items: center;
    gap: 11px;
}
.e2c-dossier .section-icon {
    width: 37px;
    height: 37px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--e2c-blue-light);
    color: var(--e2c-blue);
    font-size: 1.1rem;
    flex-shrink: 0;
}
.e2c-dossier .section-title {
    font-size: 1rem;
    font-weight: 800;
    color: #183b5b;
    margin: 0;
}
.e2c-dossier .section-subtitle {
    font-size: .77rem;
    color: var(--e2c-muted);
    margin-top: 2px;
}
.e2c-dossier .dossier-card-body {
    padding: 21px;
}
.e2c-dossier .info-item {
    padding: 11px 13px;
    border-radius: 9px;
    background: #f7f9fc;
    height: 100%;
    min-height: 67px;
}
.e2c-dossier .info-label {
    display: block;
    color: #718096;
    text-transform: uppercase;
    font-size: .69rem;
    letter-spacing: .55px;
    font-weight: 700;
    margin-bottom: 5px;
}
.e2c-dossier .info-value {
    color: #263b50;
    font-weight: 700;
    font-size: .91rem;
    overflow-wrap: anywhere;
}
.e2c-dossier .document-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid #edf1f5;
}
.e2c-dossier .document-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
}
.e2c-dossier .document-icon {
    width: 39px;
    height: 39px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #edf4fb;
    color: #245d8d;
    font-size: 1.1rem;
    flex-shrink: 0;
}
.e2c-dossier .document-name {
    font-size: .88rem;
    font-weight: 700;
    color: #263b50;
}
.e2c-dossier .document-description {
    font-size: .76rem;
    color: #7a8795;
}
.e2c-dossier .dossier-card .form-label {
    font-weight: 700;
    color: #354a60;
    font-size: .85rem;
}
.e2c-dossier .dossier-card .form-control,
.e2c-dossier .dossier-card .form-select {
    border-color: #dce4ec;
    border-radius: 8px;
    padding: 10px 12px;
}
.e2c-dossier .dossier-card .form-control:focus,
.e2c-dossier .dossier-card .form-select:focus {
    border-color: #6c9fc8;
    box-shadow: 0 0 0 .2rem rgba(45, 112, 166, .12);
}
.e2c-dossier .btn-e2c {
    background: var(--e2c-blue);
    color: #fff;
    border: 1px solid var(--e2c-blue);
    border-radius: 8px;
    font-weight: 700;
    padding: 9px 15px;
}
.e2c-dossier .btn-e2c:hover {
    background: #103655;
    color: #fff;
}
.e2c-dossier .table {
    margin-bottom: 0;
    font-size: .85rem;
}
.e2c-dossier .table thead th {
    background: #edf4fa;
    color: #244b6d;
    font-size: .73rem;
    text-transform: uppercase;
    letter-spacing: .4px;
    white-space: nowrap;
    padding: 13px 12px;
    border-bottom: 1px solid #dce7f0;
}
.e2c-dossier .table tbody td {
    padding: 13px 12px;
    color: #35475a;
    font-weight: 600;
}
.e2c-dossier .table tbody tr:nth-child(even) {
    background: #f8fbfe;
}
.e2c-dossier .table tbody tr:hover {
    background: #edf5fc;
}
.e2c-dossier .photo-form {
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.2);
    padding: 13px;
    border-radius: 11px;
}
.e2c-dossier .photo-form .form-control {
    background: #fff;
    font-size: .78rem;
}
.e2c-dossier .hero-note {
    color: #e3eef8;
    font-size: .78rem;
}
@media (max-width: 767.98px) {
    .e2c-dossier .dossier-hero {
        padding: 21px 18px;
    }
    .e2c-dossier .hero-photo,
    .e2c-dossier .hero-photo-placeholder {
        width: 88px;
        height: 108px;
    }
    .e2c-dossier .dossier-card-body {
        padding: 16px;
    }
    .e2c-dossier .dossier-card-header {
        padding: 14px 16px;
    }
}
</style>

<div class="container-fluid container-xl py-4 e2c-dossier">

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }} alert-dismissible fade show shadow-sm" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Bandeau principal d'identité #}
    <section class="dossier-hero mb-4">
        <div class="row align-items-center g-4 position-relative" style="z-index:1;">
            <div class="col-auto">
                {% if candidat.photoIdentite %}
                    <img
                        src="{{ path('candidat_photo_identite', {id: candidat.id}) }}"
                        alt="Photo d'identite de {{ candidat.nom }} {{ candidat.prenoms }}"
                        class="hero-photo"
                    >
                {% else %}
                    <div class="hero-photo-placeholder">
                        <span style="font-size:2.3rem;">&#128100;</span>
                        <small>Photo absente</small>
                    </div>
                {% endif %}
            </div>

            <div class="col">
                <div class="hero-label">METFPA · E2C · Dossier individuel</div>
                <h1 class="hero-name">{{ candidat.nom }} {{ candidat.prenoms }}</h1>
                <div class="hero-meta mb-3">
                    Référence : <strong>{{ candidat.numero }}</strong>
                    <span class="mx-2">|</span>
                    Métier : <strong>{{ candidat.metier ?: 'Non renseigné' }}</strong>
                </div>
                <span class="hero-status">
                    <span>&#10003;</span>
                    {{ candidat.statut ?: 'Statut non renseigné' }}
                </span>
            </div>

            <div class="col-12 col-lg-4">
                {% if canManagePhoto %}
                    <div class="photo-form">
                        <div class="fw-bold mb-2">Photo d'identité</div>
                        <form method="post"
                              action="{{ path('candidat_photo_identite_upload', {id: candidat.id}) }}"
                              enctype="multipart/form-data">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('photo_identite_' ~ candidat.id) }}">
                            <input type="file" name="photo"
                                   class="form-control form-control-sm mb-2"
                                   accept="image/jpeg,image/png" required>
                            <button type="submit" class="btn btn-light btn-sm fw-bold">
                                {% if candidat.photoIdentite %}Remplacer la photo{% else %}Ajouter la photo{% endif %}
                            </button>
                        </form>
                        <div class="hero-note mt-2">Format JPEG ou PNG · 5 Mo maximum</div>
                    </div>
                {% elseif not isAdmis %}
                    <div class="hero-note">
                        La photo d'identité sera ajoutée après l'admission officielle.
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <div class="row g-4">

        {# Informations personnelles #}
        <div class="col-lg-8">
            <section class="dossier-card">
                <div class="dossier-card-header">
                    <span class="section-icon">&#128100;</span>
                    <div>
                        <h2 class="section-title">État civil et informations personnelles</h2>
                        <div class="section-subtitle">Informations d'identification du candidat</div>
                    </div>
                </div>
                <div class="dossier-card-body">
                    <div class="row g-3">
                        <div class="col-sm-6 col-md-4">
                            <div class="info-item">
                                <span class="info-label">Nom</span>
                                <div class="info-value">{{ candidat.nom ?: 'Non renseigné' }}</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="info-item">
                                <span class="info-label">Prénoms</span>
                                <div class="info-value">{{ candidat.prenoms ?: 'Non renseignés' }}</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="info-item">
                                <span class="info-label">Sexe</span>
                                <div class="info-value">{{ candidat.sexe ?: 'Non renseigné' }}</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="info-item">
                                <span class="info-label">Date de naissance</span>
                                <div class="info-value">
                                    {% if candidat.dateNaissance %}
                                        {{ candidat.dateNaissance|date('d/m/Y') }}
                                    {% else %}
                                        Non renseignée
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="info-item">
                                <span class="info-label">Âge</span>
                                <div class="info-value">
                                    {% if candidat.age is not null %}{{ candidat.age }} ans{% else %}Non renseigné{% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-4">
                            <div class="info-item">
                                <span class="info-label">Nationalité</span>
                                <div class="info-value">{{ candidat.nationalite ?: 'Non renseignée' }}</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6">
                            <div class="info-item">
                                <span class="info-label">Lieu de résidence</span>
                                <div class="info-value">{{ candidat.lieuResidence ?: 'Non renseigné' }}</div>
                            </div>
                        </div>
                        <div class="col-sm-6 col-md-6">
                            <div class="info-item">
                                <span class="info-label">Téléphone</span>
                                <div class="info-value">{{ candidat.telephone ?: 'Non renseigné' }}</div>
                            </div>
                        </div>
<div class="col-sm-6 col-md-6">
    <div class="info-item">
        <span class="info-label">Adresse e-mail</span>

        {% if canManageEmail %}
            <form method="post"
                  action="{{ path('candidat_email_update', {id: candidat.id}) }}"
                  class="mt-2">
                <input type="hidden"
                       name="_token"
                       value="{{ csrf_token('modifier_email_' ~ candidat.id) }}">

                <div class="input-group">
                    <input type="email"
                           name="email"
                           class="form-control"
                           maxlength="180"
                           autocomplete="email"
                           value="{{ candidat.email|default('') }}"
                           placeholder="Adresse e-mail facultative">
                    <button type="submit" class="btn btn-primary">
                        Enregistrer
                    </button>
                </div>
                <small class="text-muted">
                    Laissez vide pour supprimer l'adresse e-mail.
                </small>
            </form>
        {% else %}
            <div class="info-value">
                {{ candidat.email ?: 'Non renseignée' }}
            </div>
        {% endif %}
    </div>
</div>
                    </div>
                </div>
            </section>
        </div>

        {# Situation du candidat #}
        <div class="col-lg-4">
            <section class="dossier-card">
                <div class="dossier-card-header">
                    <span class="section-icon">&#127891;</span>
                    <div>
                        <h2 class="section-title">Situation du candidat</h2>
                        <div class="section-subtitle">Orientation et métier</div>
                    </div>
                </div>
                <div class="dossier-card-body">
                    <div class="mb-3">
                        <span class="info-label">Métier de formation</span>
                        <div class="info-value fs-5">{{ candidat.metier ?: 'Non renseigné' }}</div>
                    </div>
                    <hr>
                    <div>
                        <span class="info-label">Référence du candidat</span>
                        <div class="info-value">{{ candidat.numero }}</div>
                    </div>
                    <div class="mt-3">
                        <span class="info-label">Statut actuel</span>
                        <div class="info-value">{{ candidat.statut ?: 'Non renseigné' }}</div>
                    </div>
                </div>
            </section>
        </div>

        {# Pièces fournies à l'inscription #}
        <div class="col-lg-6">
            <section class="dossier-card">
                <div class="dossier-card-header">
                    <span class="section-icon">&#128196;</span>
                    <div>
                        <h2 class="section-title">Pièces fournies à l'inscription</h2>
                        <div class="section-subtitle">Justificatifs administratifs du candidat</div>
                    </div>
                </div>
                <div class="dossier-card-body">
                    <div class="document-row">
                        <div class="d-flex align-items-center gap-3">
                            <span class="document-icon">&#128196;</span>
                            <div>
                                <div class="document-name">Pièce d'identité</div>
                                <div class="document-description">
                                    {% if candidat.pieceIdentiteFichier %}
                                        Document enregistré
                                    {% else %}
                                        Document non fourni
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        {% if candidat.pieceIdentiteFichier %}
                            <a class="btn btn-outline-primary btn-sm"
                               href="{{ path('candidat_inscription_document_download', {id: candidat.id, type: 'piece-identite'}) }}">
                                Télécharger
                            </a>
                        {% else %}
                            <span class="badge bg-secondary">Absent</span>
                        {% endif %}
                    </div>

                    <div class="document-row">
                        <div class="d-flex align-items-center gap-3">
                            <span class="document-icon">&#127891;</span>
                            <div>
                                <div class="document-name">Diplôme ou certificat</div>
                                <div class="document-description">
                                    {% if candidat.diplomeFichier %}
                                        Justificatif enregistré
                                    {% else %}
                                        Justificatif non fourni
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        {% if candidat.diplomeFichier %}
                            <a class="btn btn-outline-primary btn-sm"
                               href="{{ path('candidat_inscription_document_download', {id: candidat.id, type: 'diplome'}) }}">
                                Télécharger
                            </a>
                        {% else %}
                            <span class="badge bg-secondary">Absent</span>
                        {% endif %}
                    </div>
                </div>
            </section>
        </div>

        {# Ajout de document : gestionnaire uniquement #}
        {% if canManageDocuments %}
        <div class="col-lg-6">
            <section class="dossier-card">
                <div class="dossier-card-header">
                    <span class="section-icon">&#128221;</span>
                    <div>
                        <h2 class="section-title">Ajouter un document</h2>
                        <div class="section-subtitle">Compléter le dossier administratif</div>
                    </div>
                </div>
                <div class="dossier-card-body">
                    <form method="post"
                          action="{{ path('candidat_document_add', {id: candidat.id}) }}"
                          enctype="multipart/form-data">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('ajouter_document_' ~ candidat.id) }}">

                        <div class="mb-3">
                            <label for="categorie" class="form-label">Catégorie du document</label>
                            <select id="categorie" name="categorie" class="form-select" required>
                                <option value="">Choisir une catégorie</option>
                                <option value="piece_identite">Pièce d'identité</option>
                                <option value="diplome">Diplôme ou certificat</option>
                                <option value="acte_naissance">Acte de naissance</option>
                                <option value="certificat_medical">Certificat médical</option>
                                <option value="attestation_formation">Attestation de formation</option>
                                <option value="convention_stage">Convention de stage</option>
                                <option value="evaluation">Évaluation pédagogique</option>
                                <option value="autre">Autre document</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="intitule" class="form-label">Titre du document</label>
                            <input id="intitule" name="intitule" class="form-control"
                                   maxlength="180" required
                                   placeholder="Ex. : Attestation de formation">
                        </div>

                        <div class="mb-3">
                            <label for="document" class="form-label">Fichier à joindre</label>
                            <input id="document" type="file" name="document"
                                   class="form-control"
                                   accept=".pdf,.jpg,.jpeg,.png" required>
                            <div class="form-text">PDF, JPG, JPEG ou PNG · 10 Mo maximum.</div>
                        </div>

                        <button type="submit" class="btn btn-e2c w-100">
                            Ajouter au dossier
                        </button>
                    </form>
                </div>
            </section>
        </div>
        {% endif %}

        {# Documents complémentaires #}
        <div class="col-12">
            <section class="dossier-card">
                <div class="dossier-card-header">
                    <span class="section-icon">&#128209;</span>
                    <div>
                        <h2 class="section-title">Dossier administratif et pièces jointes</h2>
                        <div class="section-subtitle">Historique des documents enregistrés</div>
                    </div>
                    <span class="badge bg-light text-primary border ms-auto">
                        {{ documents|length }} document(s)
                    </span>
                </div>
                <div class="dossier-card-body">
                    {% if documents is empty %}
                        <div class="text-center py-4">
                            <div style="font-size:2.2rem;color:#9aabba;">&#128196;</div>
                            <div class="fw-bold mt-2">Aucun document complémentaire</div>
                            <div class="text-muted small">Les documents ajoutés apparaîtront dans cet espace.</div>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Document</th>
                                        <th>Catégorie</th>
                                        <th>Nom du fichier</th>
                                        <th>Taille</th>
                                        <th>Date d'ajout</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for document in documents %}
                                        <tr>
                                            <td>{{ document.intitule }}</td>
                                            <td>
                                                {% if document.categorie == 'piece_identite' %}
                                                    Pièce d'identité
                                                {% elseif document.categorie == 'diplome' %}
                                                    Diplôme ou certificat
                                                {% elseif document.categorie == 'acte_naissance' %}
                                                    Acte de naissance
                                                {% elseif document.categorie == 'certificat_medical' %}
                                                    Certificat médical
                                                {% elseif document.categorie == 'attestation_formation' %}
                                                    Attestation de formation
                                                {% elseif document.categorie == 'convention_stage' %}
                                                    Convention de stage
                                                {% elseif document.categorie == 'evaluation' %}
                                                    Évaluation pédagogique
                                                {% else %}
                                                    Autre document
                                                {% endif %}
                                            </td>
                                            <td>{{ document.nomOriginal }}</td>
                                            <td>{{ (document.tailleOctets / 1024)|round }} Ko</td>
                                            <td>
                                                {% if document.dateAjout %}
                                                    {{ document.dateAjout|date('d/m/Y H:i') }}
                                                {% else %}
                                                    -
                                                {% endif %}
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-outline-primary btn-sm"
                                                   href="{{ path('candidat_document_download', {id: candidat.id, documentId: document.id}) }}">
                                                    Télécharger
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </section>
        </div>


        {# Equipe d'accompagnement : trois responsabilités indépendantes #}
        <section class="col-12" id="equipe-accompagnement-responsables">
            {% set responsabilites = {
                'REFERENT_PARCOURS': {
                    'titre': 'Référent de parcours',
                    'description': 'Accompagnement socio-professionnel et suivi du parcours.'
                },
                'FORMATEUR': {
                    'titre': 'Formateur',
                    'description': 'Formation théorique et évaluations pédagogiques.'
                },
                'MAITRE_STAGE': {
                    'titre': 'Maître de stage',
                    'description': 'Encadrement pratique et suivi en milieu professionnel.'
                }
            } %}

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div>
                            <h2 class="h5 mb-1">Équipe d'accompagnement</h2>
                            <p class="text-muted small mb-0">
                                Les trois responsabilités sont distinctes et peuvent être confiées à des personnes différentes.
                            </p>
                        </div>
                        {% if isAdmis %}
                            <span class="badge bg-success">Candidat admis</span>
                        {% else %}
                            <span class="badge bg-secondary">En attente d'admission</span>
                        {% endif %}
                    </div>
                </div>

                <div class="card-body">
                    {% if not isAdmis %}
                        <div class="alert alert-info mb-0">
                            L'affectation des responsables sera disponible après la décision d'admission.
                        </div>
                    {% else %}
                        <div class="row g-3">
                            {% for type, configuration in responsabilites %}
                                {% set affectation = responsablesActifs[type]|default(null) %}
                                {% set choix = responsablesDisponibles[type]|default([]) %}

                                <div class="col-12 col-lg-4">
                                    <div class="card h-100 border rounded-3">
                                        <div class="card-body">
                                            <h3 class="h6 fw-bold mb-2">
                                                {{ configuration.titre }}
                                            </h3>

                                            <p class="text-muted small mb-3">
                                                {{ configuration.description }}
                                            </p>

                                            {% if affectation and affectation.responsable %}
                                                <div class="rounded-3 bg-light p-3 mb-3">
                                                    <div class="small text-muted mb-1">
                                                        Responsable actuel
                                                    </div>
                                                    <div class="fw-semibold">
                                                        {{ affectation.responsable.prenoms }}
                                                        {{ affectation.responsable.nom }}
                                                    </div>
                                                    <div class="small text-muted mt-2">
                                                        Depuis le
                                                        {{ affectation.dateDebut|date('d/m/Y') }}
                                                    </div>
                                                    <span class="badge bg-success mt-2">
                                                        En fonction
                                                    </span>
                                                </div>
                                            {% else %}
                                                <div class="alert alert-warning small mb-3">
                                                    Aucun responsable affecté actuellement.
                                                </div>
                                            {% endif %}

                                            {% if canManageResponsables %}
                                                <form method="post"
                                                      action="{{ path('candidat_responsable_affecter', {
                                                          id: candidat.id,
                                                          type: type
                                                      }) }}">

                                                    <input type="hidden"
                                                           name="_token"
                                                           value="{{ csrf_token('affectation_responsable_' ~ candidat.id ~ '_' ~ type) }}">

                                                    <label class="form-label small fw-semibold"
                                                           for="responsable-{{ type }}">
                                                        {% if affectation %}
                                                            Remplacer le responsable
                                                        {% else %}
                                                            Choisir un responsable
                                                        {% endif %}
                                                    </label>

                                                    {% if choix|length > 0 %}
                                                        <select class="form-select form-select-sm mb-3"
                                                                id="responsable-{{ type }}"
                                                                name="responsable_id"
                                                                required>
                                                            <option value="">
                                                                Sélectionner un compte
                                                            </option>
                                                            {% for utilisateur in choix %}
                                                                <option value="{{ utilisateur.id }}">
                                                                    {{ utilisateur.prenoms }}
                                                                    {{ utilisateur.nom }}
                                                                </option>
                                                            {% endfor %}
                                                        </select>

                                                        <button type="submit"
                                                                class="btn btn-primary btn-sm w-100">
                                                            {% if affectation %}
                                                                Remplacer
                                                            {% else %}
                                                                Affecter
                                                            {% endif %}
                                                        </button>
                                                    {% else %}
                                                        <div class="alert alert-secondary small mb-0">
                                                            Aucun compte actif ne possède actuellement le profil requis.
                                                        </div>
                                                    {% endif %}
                                                </form>
                                            {% endif %}

                                            {% set historiqueTrouve = false %}
                                            {% for ancienne in affectationsResponsables %}
                                                {% if ancienne.typeResponsabilite == type %}
                                                    {% set historiqueTrouve = true %}
                                                {% endif %}
                                            {% endfor %}

                                            {% if historiqueTrouve %}
                                                <details class="mt-3">
                                                    <summary class="small fw-semibold text-primary">
                                                        Voir l'historique des affectations
                                                    </summary>
                                                    <div class="mt-2">
                                                        {% for ancienne in affectationsResponsables %}
                                                            {% if ancienne.typeResponsabilite == type %}
                                                                <div class="border-top py-2 small">
                                                                    <div class="fw-semibold">
                                                                        {{ ancienne.responsable.prenoms }}
                                                                        {{ ancienne.responsable.nom }}
                                                                    </div>
                                                                    <div class="text-muted">
                                                                        Du {{ ancienne.dateDebut|date('d/m/Y') }}
                                                                        {% if ancienne.dateFin %}
                                                                            au {{ ancienne.dateFin|date('d/m/Y') }}
                                                                        {% else %}
                                                                            à aujourd'hui
                                                                        {% endif %}
                                                                    </div>
                                                                    <span class="badge
                                                                        {% if ancienne.statut == 'ACTIVE' %}
                                                                            bg-success
                                                                        {% else %}
                                                                            bg-secondary
                                                                        {% endif %}">
                                                                        {{ ancienne.statut }}
                                                                    </span>
                                                                </div>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </div>
                                                </details>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>
    </div>
</div>
{% endblock %}