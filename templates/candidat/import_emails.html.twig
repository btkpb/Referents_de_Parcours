{% extends 'base.html.twig' %}

{% block title %}Importation des e-mails | E2C-MTFPA{% endblock %}

{% block body %}

<style>
.e2c-import-page {
    --e2c-navy: #17365d;
    --e2c-blue: #1769aa;
    --e2c-light: #f3f6fb;
    --e2c-border: #e3eaf2;
    color: #26364a;
    padding: 24px 0 48px;
}
.e2c-import-page .page-header {
    background: linear-gradient(120deg, #17365d 0%, #1769aa 100%);
    border-radius: 18px;
    padding: 30px;
    color: #fff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 12px 28px rgba(23,54,93,.16);
}
.e2c-import-page .page-header::after {
    content: "";
    position: absolute;
    width: 240px;
    height: 240px;
    right: -65px;
    top: -115px;
    border: 35px solid rgba(255,255,255,.08);
    border-radius: 50%;
}
.e2c-import-page .header-content {
    position: relative;
    z-index: 1;
}
.e2c-import-page .institution-label {
    font-size: .76rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,255,255,.78);
}
.e2c-import-page .page-header h1 {
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
    margin: 9px 0;
    color: #ffffff !important;
}
.e2c-import-page .page-header p {
    color: rgba(255,255,255,.84);
    margin: 0;
    max-width: 650px;
}
.e2c-import-page .header-back {
    border: 1px solid rgba(255,255,255,.55);
    color: #fff;
    border-radius: 9px;
    padding: 10px 15px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    white-space: nowrap;
}
.e2c-import-page .header-back:hover {
    background: rgba(255,255,255,.13);
    color: #fff;
}
.e2c-import-page .section-card {
    background: #fff;
    border: 1px solid var(--e2c-border);
    border-radius: 15px;
    box-shadow: 0 5px 18px rgba(23,54,93,.045);
    height: 100%;
}
.e2c-import-page .section-card .card-inner {
    padding: 24px;
}
.e2c-import-page .step-number {
    width: 35px;
    height: 35px;
    min-width: 35px;
    border-radius: 10px;
    background: #e9f2fc;
    color: var(--e2c-blue);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
}
.e2c-import-page .section-title {
    font-size: 1.08rem;
    font-weight: 750;
    color: var(--e2c-navy);
    margin: 0;
}
.e2c-import-page .section-description {
    color: #718096;
    font-size: .91rem;
}
.e2c-import-page .download-panel {
    background: linear-gradient(135deg, #f0f6fd, #f8fbff);
    border: 1px solid #dce9f7;
    border-radius: 12px;
    padding: 18px;
}
.e2c-import-page .download-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #dcecff;
    color: var(--e2c-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 800;
}
.e2c-import-page .column-code {
    display: inline-block;
    background: #edf2f7;
    border: 1px solid #e1e8f0;
    border-radius: 5px;
    padding: 3px 7px;
    color: #29435f;
    font-size: .82rem;
    font-weight: 700;
}
.e2c-import-page .upload-zone {
    border: 2px dashed #b9cde2;
    background: #f8fbff;
    border-radius: 13px;
    padding: 27px 18px;
    text-align: center;
    transition: .2s ease;
}
.e2c-import-page .upload-zone:hover,
.e2c-import-page .upload-zone:focus-within {
    border-color: var(--e2c-blue);
    background: #f0f6fd;
}
.e2c-import-page .upload-symbol {
    width: 55px;
    height: 55px;
    border-radius: 16px;
    background: #e3effc;
    color: var(--e2c-blue);
    font-size: 1.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}
.e2c-import-page .upload-zone input[type=file] {
    max-width: 100%;
    margin-top: 14px;
}
.e2c-import-page .file-name {
    display: block;
    color: var(--e2c-blue);
    font-size: .88rem;
    font-weight: 650;
    margin-top: 10px;
    overflow-wrap: anywhere;
}
.e2c-import-page .limit-chip {
    display: inline-block;
    padding: 6px 10px;
    background: #f0f3f7;
    border-radius: 7px;
    color: #617184;
    font-size: .78rem;
    font-weight: 650;
    margin: 3px 3px 0 0;
}
.e2c-import-page .btn-primary {
    background: var(--e2c-blue);
    border-color: var(--e2c-blue);
    font-weight: 650;
    border-radius: 9px;
    padding: 10px 17px;
}
.e2c-import-page .btn-primary:hover {
    background: #12558c;
    border-color: #12558c;
}
.e2c-import-page .btn-success {
    font-weight: 700;
    border-radius: 9px;
    padding: 11px 18px;
}
.e2c-import-page .summary-card {
    border: 1px solid var(--e2c-border);
    border-radius: 12px;
    padding: 16px;
    background: #fff;
    height: 100%;
}
.e2c-import-page .summary-label {
    color: #728096;
    font-size: .82rem;
    font-weight: 600;
}
.e2c-import-page .summary-value {
    color: var(--e2c-navy);
    font-size: 1.65rem;
    line-height: 1.3;
    font-weight: 800;
}
.e2c-import-page .summary-dot {
    width: 9px;
    height: 9px;
    display: inline-block;
    border-radius: 50%;
    margin-right: 5px;
}
.e2c-import-page .table {
    margin-bottom: 0;
    font-size: .9rem;
}
.e2c-import-page .table thead th {
    background: #f2f6fb;
    color: #42566e;
    font-size: .78rem;
    text-transform: uppercase;
    letter-spacing: .035em;
    white-space: nowrap;
    padding: 13px 12px;
    border-bottom: 1px solid #dfe7f0;
}
.e2c-import-page .table tbody td {
    padding: 12px;
    border-color: #edf1f5;
}
.e2c-import-page .table tbody tr:hover {
    background: #f8fbff;
}
.e2c-import-page .status-pill {
    display: inline-block;
    border-radius: 20px;
    padding: 6px 10px;
    font-size: .76rem;
    font-weight: 700;
}
.e2c-import-page .status-update {
    color: #17633c;
    background: #e4f5eb;
}
.e2c-import-page .status-delete {
    color: #805500;
    background: #fff2cf;
}
.e2c-import-page .status-same {
    color: #566579;
    background: #edf1f5;
}
.e2c-import-page .notice-panel {
    border-radius: 11px;
    padding: 15px 17px;
    background: #fff8e7;
    border: 1px solid #f1dfb1;
    color: #755516;
    font-size: .9rem;
}
.e2c-import-page .error-panel {
    border: 1px solid #f0caca;
    border-radius: 13px;
    background: #fff8f8;
    padding: 20px;
}
.e2c-import-page .error-panel h3 {
    color: #a52b35;
    font-size: 1rem;
    font-weight: 750;
}
.e2c-import-page .error-list {
    max-height: 280px;
    overflow-y: auto;
    padding-left: 22px;
    margin-bottom: 0;
    color: #7c343a;
    font-size: .88rem;
}
.e2c-import-page .error-list li {
    padding: 4px 0;
}
.e2c-import-page .workflow-label {
    font-size: .76rem;
    color: #8a98a9;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
}
@media (max-width: 767.98px) {
    .e2c-import-page {
        padding-top: 12px;
    }
    .e2c-import-page .page-header {
        padding: 22px 19px;
    }
    .e2c-import-page .header-back {
        margin-top: 18px;
    }
    .e2c-import-page .section-card .card-inner {
        padding: 18px;
    }
    .e2c-import-page .table {
        min-width: 720px;
    }
}
</style>

<div class="container e2c-import-page">

    <div class="page-header mb-4">
        <div class="header-content d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <div class="institution-label">E2C-MTFPA · Gestion administrative</div>
                <h1>Importation des e-mails</h1>
                <p>Actualisez les adresses électroniques des candidats en une seule opération, à partir d'un fichier Excel ou CSV.</p>
            </div>
            <a href="{{ path('candidat_index') }}" class="header-back">
                ← Retour aux candidats
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <strong>Opération réussie.</strong> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show rounded-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    {% endfor %}

    <div class="row g-4 mb-4">

        <div class="col-lg-5">
            <section class="section-card">
                <div class="card-inner">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="step-number">01</span>
                        <div>
                            <div class="workflow-label">Préparation</div>
                            <h2 class="section-title">Télécharger le modèle</h2>
                        </div>
                    </div>

                    <p class="section-description">
                        Utilisez le modèle officiel pour préparer correctement votre fichier.
                    </p>

                    <div class="download-panel">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="download-icon">XLS</div>
                            <div>
                                <div class="fw-bold text-dark">Modèle Excel E2C-MTFPA</div>
                                <div class="small text-muted">Fichier prêt à compléter</div>
                            </div>
                        </div>

                        <div class="small text-muted mb-3">Deux colonnes sont obligatoires :</div>
                        <div class="mb-2">
                            <span class="column-code">numero_candidat</span>
                            <div class="small text-muted mt-1">Numéro officiel permettant d'identifier le candidat.</div>
                        </div>
                        <div class="mb-3">
                            <span class="column-code">email</span>
                            <div class="small text-muted mt-1">Adresse électronique à enregistrer.</div>
                        </div>

                        <a href="{{ path('candidat_import_emails_modele') }}"
                           class="btn btn-outline-primary w-100">
                            ↓ Télécharger le modèle Excel
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="section-card">
                <div class="card-inner">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="step-number">02</span>
                        <div>
                            <div class="workflow-label">Chargement du fichier</div>
                            <h2 class="section-title">Sélectionner les données</h2>
                        </div>
                    </div>

                    <p class="section-description">
                        Importez votre fichier. Une analyse sera réalisée avant toute modification des dossiers.
                    </p>

                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('import_emails_candidats') }}">

                        <div class="upload-zone mb-3">
                            <div class="upload-symbol">↑</div>
                            <div class="fw-bold text-dark">Choisir un fichier à analyser</div>
                            <div class="small text-muted mt-1">Excel ou CSV préparé à partir du modèle</div>

                            <input type="file"
                                   id="fichier"
                                   name="fichier"
                                   class="form-control"
                                   accept=".xlsx,.xls,.csv"
                                   required
                                   aria-describedby="fileHelp">

                            <span class="file-name" id="fileName" aria-live="polite">
                                Aucun fichier sélectionné
                            </span>
                        </div>

                        <div id="fileHelp" class="mb-3">
                            <span class="limit-chip">XLSX</span>
                            <span class="limit-chip">XLS</span>
                            <span class="limit-chip">CSV</span>
                            <span class="limit-chip">Maximum 5 Mo</span>
                            <span class="limit-chip">5 000 lignes maximum</span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Analyser et prévisualiser le fichier →
                        </button>
                    </form>

                    <div class="small text-muted mt-3">
                        <strong>Protection :</strong> aucun e-mail n'est modifié à cette étape.
                        Vous pourrez examiner les résultats avant de confirmer.
                    </div>
                </div>
            </section>
        </div>

    </div>

    {% if erreurs is not empty %}
        <section class="error-panel mb-4">
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="text-danger fs-4">!</span>
                <h3 class="mb-0">Anomalies détectées pendant l'analyse</h3>
            </div>
            <p class="small text-muted mb-3">
                Les lignes signalées ci-dessous ne seront pas incluses dans la prévisualisation des opérations valides.
            </p>
            <ul class="error-list">
                {% for erreur in erreurs %}
                    <li>{{ erreur }}</li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if lignes is not empty %}

        {% set nbMisesAJour = 0 %}
        {% set nbSuppressions = 0 %}
        {% set nbInchangees = 0 %}

        {% for ligne in lignes %}
            {% if ligne.action starts with 'Suppression' %}
                {% set nbSuppressions = nbSuppressions + 1 %}
            {% elseif ligne.action == 'Adresse inchangée' %}
                {% set nbInchangees = nbInchangees + 1 %}
            {% else %}
                {% set nbMisesAJour = nbMisesAJour + 1 %}
            {% endif %}
        {% endfor %}

        <section class="section-card mb-4">
            <div class="card-inner">

                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <span class="step-number">03</span>
                            <div class="workflow-label">Contrôle avant enregistrement</div>
                        </div>
                        <h2 class="section-title mb-2">Prévisualisation des opérations</h2>
                        <p class="section-description mb-0">
                            Vérifiez chaque ligne avant de confirmer l'importation.
                        </p>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        Aperçu disponible
                    </span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-label">Lignes valides</div>
                            <div class="summary-value">{{ lignes|length }}</div>
                            <div class="small text-muted">Présentes dans l'aperçu</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-label">Mises à jour</div>
                            <div class="summary-value text-success">{{ nbMisesAJour }}</div>
                            <div class="small text-muted">Nouvelles adresses</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-label">Suppressions</div>
                            <div class="summary-value text-warning">{{ nbSuppressions }}</div>
                            <div class="small text-muted">Adresses à effacer</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="summary-card">
                            <div class="summary-label">Inchangées</div>
                            <div class="summary-value">{{ nbInchangees }}</div>
                            <div class="small text-muted">Aucune modification</div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive border rounded-3 mb-4">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th scope="col">Ligne</th>
                                <th scope="col">Numéro du candidat</th>
                                <th scope="col">Adresse e-mail</th>
                                <th scope="col">Opération prévue</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in lignes %}
                                <tr>
                                    <td class="text-muted">{{ ligne.ligne }}</td>
                                    <td class="fw-bold text-nowrap">{{ ligne.numero }}</td>
                                    <td>
                                        {% if ligne.email is null %}
                                            <span class="text-muted fst-italic">Adresse vide</span>
                                        {% else %}
                                            <span class="text-break">{{ ligne.email }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if ligne.action starts with 'Suppression' %}
                                            <span class="status-pill status-delete">
                                                {{ ligne.action }}
                                            </span>
                                        {% elseif ligne.action == 'Adresse inchangée' %}
                                            <span class="status-pill status-same">
                                                {{ ligne.action }}
                                            </span>
                                        {% else %}
                                            <span class="status-pill status-update">
                                                {{ ligne.action }}
                                            </span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="notice-panel mb-4">
                    <strong>Attention aux cellules vides :</strong>
                    une adresse e-mail vide dans le fichier signifie que l'adresse actuellement enregistrée sera supprimée.
                    Vérifiez particulièrement les lignes signalées comme suppressions.
                    Aucune modification n'est réalisée avant votre confirmation.
                </div>

                <form method="post"
                      action="{{ path('candidat_import_emails_confirmer') }}"
                      onsubmit="return confirm('Confirmez-vous l’importation des adresses e-mail affichées ?');">

                    <input type="hidden" name="_token"
                           value="{{ csrf_token('confirmer_import_emails_candidats') }}">

                    {% if nbSuppressions > 0 %}
                        <div class="alert alert-warning mb-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="autoriser_suppressions"
                                       name="autoriser_suppressions"
                                       value="1"
                                       required>
                                <label class="form-check-label fw-semibold"
                                       for="autoriser_suppressions">
                                    Je confirme et j’autorise explicitement la suppression des
                                    {{ nbSuppressions }} adresse(s) e-mail correspondant aux cellules vides du fichier.
                                </label>
                            </div>
                        </div>
                    {% endif %}

                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <a href="{{ path('candidat_import_emails') }}"
                           class="btn btn-outline-secondary">
                            Annuler et recommencer
                        </a>

                        <button type="submit" class="btn btn-success">
                            Confirmer et enregistrer les e-mails →
                        </button>
                    </div>
                </form>

            </div>
        </section>

    {% endif %}

    <div class="text-center text-muted small mt-4">
        E2C-MTFPA · Gestion sécurisée des données des candidats
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const input = document.getElementById('fichier');
    const fileName = document.getElementById('fileName');

    if (!input || !fileName) {
        return;
    }

    input.addEventListener('change', function () {
        if (input.files && input.files.length > 0) {
            const fichier = input.files[0];
            const tailleMo = (fichier.size / (1024 * 1024)).toFixed(2);

            fileName.textContent = fichier.name + ' — ' + tailleMo + ' Mo';
        } else {
            fileName.textContent = 'Aucun fichier sélectionné';
        }
    });
});
</script>

{% endblock %}