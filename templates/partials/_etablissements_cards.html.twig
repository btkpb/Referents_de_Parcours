{% for etablissement in etablissements|default([]) %}
    <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">
            {{ etablissement.nom|default(etablissement.name|default('Établissement')) }}
        </h3>
        {% if etablissement.ville|default('') %}
            <p class="mt-2 text-sm text-gray-600">{{ etablissement.ville }}</p>
        {% endif %}
        {% if etablissement.description|default('') %}
            <p class="mt-3 text-sm text-gray-700">{{ etablissement.description }}</p>
        {% endif %}
    </article>
{% else %}
    <div class="col-span-full rounded-xl border border-dashed border-gray-300 p-6 text-center text-gray-600">
        <p class="font-medium">Aucun établissement à afficher pour le moment.</p>
        <p class="mt-1 text-sm">Les établissements disponibles apparaîtront ici lorsqu’ils seront configurés.</p>
    </div>
{% endfor %}