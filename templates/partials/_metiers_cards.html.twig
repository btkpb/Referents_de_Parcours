{% for metier in metiers|default([]) %}
    <article class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">
            {{ metier.nom|default(metier.name|default('Métier')) }}
        </h3>

        {% if metier.secteur|default('') %}
            <p class="mt-2 text-sm text-gray-600">{{ metier.secteur }}</p>
        {% endif %}

        {% if metier.description|default('') %}
            <p class="mt-3 text-sm text-gray-700">{{ metier.description }}</p>
        {% endif %}
    </article>
{% else %}
    <div class="col-span-full rounded-xl border border-dashed border-gray-300 p-6 text-center text-gray-600">
        <p class="font-medium">Aucun métier à afficher pour le moment.</p>
        <p class="mt-1 text-sm">Les métiers seront présentés ici lorsqu'ils seront disponibles.</p>
    </div>
{% endfor %}