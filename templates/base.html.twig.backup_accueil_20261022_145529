<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}METFPA - E2C{% endblock %}</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">

    {% block stylesheets %}{% endblock %}
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body>

<nav class="daip-navbar">
    <div class="daip-nav-container">

        <a class="daip-brand" href="{{ path('daip_accueil') }}">
            <img
                src="{{ asset('images/logo DAIP.png') }}"
                alt="Logo DAIP"
                class="daip-logo"
            >
        </a>

        {% set roles = app.user ? app.user.roles : [] %}

        {% set estAdmin =
            is_granted('ROLE_ADMIN')
            or is_granted('ROLE_ADMINISTRATEUR')
            or is_granted('ROLE_SUPER_ADMIN')
            or 'ADMIN' in roles
            or 'ROLE_ADMINISTRATEUR' in roles
        %}

        {% set estGestionnaire =
            estAdmin
            or is_granted('ROLE_GESTIONNAIRE')
            or 'GESTIONNAIRE' in roles
        %}

        {% set estJury =
            is_granted('ROLE_JURY')
            or 'JURY' in roles
        %}

        {% set estReferent =
            is_granted('ROLE_REFERENT_PARCOURS')
            or is_granted('ROLE_REFERENT')
            or 'REFERENT_PARCOURS' in roles
            or 'REFERENT' in roles
        %}

        {% set estFormateur =
            is_granted('ROLE_FORMATEUR')
            or 'FORMATEUR' in roles
        %}

        {% set estApprenti =
            is_granted('ROLE_APPRENTI')
            or 'APPRENTI' in roles
        %}

        <button
            class="daip-menu-toggle"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#daipNavigation"
            aria-controls="daipNavigation"
            aria-expanded="false"
            aria-label="Afficher ou masquer le menu"
        >
            ☰ Menu
        </button>

        <div class="daip-navigation-collapse" id="daipNavigation">

            <div class="daip-nav-links">

                <a href="{{ path('daip_accueil') }}">Accueil</a>

                {% if not app.user %}

                    <a href="{{ path('public_inscription') }}">
                        Inscription
                    </a>

                    <a href="{{ path('daip_accueil') }}#contact">
                        Contacts
                    </a>

                {% else %}

                    {% if estAdmin %}

                        <a href="/candidats">Candidatures</a>
                        <a href="/recrutement/entretiens">Entretiens</a>
                        <a href="/medical">Visites médicales</a>
                        <a href="/annuaire">Admissions et annuaire</a>
                        <a href="/suivi">Suivi des apprentis</a>
                        <a href="/etablissements">Établissements</a>
                        <a href="/metiers">Métiers</a>

                    {% elseif estGestionnaire %}

                        <a href="/candidats">Candidatures</a>
                        <a href="/recrutement/entretiens">Planification des entretiens</a>
                        <a href="/medical">Visites médicales</a>
                        <a href="/annuaire">Admissions et annuaire</a>
                        <a href="/etablissements">Établissements</a>
                        <a href="/metiers">Métiers</a>

                    {% elseif estJury %}

                        <a href="/recrutement/entretiens">Mes entretiens</a>

                    {% elseif estReferent %}

                        <a href="/annuaire">Annuaire des apprentis</a>
                        <a href="/suivi">Suivi des parcours</a>

                    {% elseif estFormateur %}

                        <a href="/suivi">Suivi des apprentis</a>

                    {% elseif estApprenti %}

                        <a href="/annuaire">Annuaire</a>

                    {% else %}

                        <a href="{{ path('daip_accueil') }}#contact">
                            Contacts
                        </a>

                    {% endif %}

                    {% if estAdmin or estGestionnaire or estJury
                        or estReferent or estFormateur or estApprenti %}
                        <a href="{{ path('daip_accueil') }}#contact">
                            Contacts
                        </a>
                    {% endif %}

                {% endif %}

            </div>

            <div class="daip-nav-login">

                {% if app.user %}

                    <span class="daip-user-label">
                        {{ app.user.userIdentifier }}
                    </span>

                    <a
                        class="daip-login-btn"
                        href="{{ path('app_logout') }}"
                    >
                        Déconnexion
                    </a>

                {% else %}

                    <a
                        class="daip-login-btn"
                        href="{{ path('app_login') }}"
                    >
                        Connexion
                    </a>

                {% endif %}

            </div>

        </div>
    </div>
</nav>

<main class="container py-4 daip-main">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% block body %}{% endblock %}

</main>

<footer class="daip-footer">
    <small>
        METFPA - E2C | Formation, apprentissage et insertion
    </small>
</footer>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
></script>

{% block javascripts %}{% endblock %}

</body>
</html>

