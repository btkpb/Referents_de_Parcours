{% extends 'base.html.twig' %}

{% block body %}

    {% set roles = app.user ? app.user.roles : [] %}

    {% set estAdmin =
        is_granted('ROLE_ADMIN')
        or is_granted('ROLE_ADMINISTRATEUR')
        or is_granted('ROLE_SUPER_ADMIN')
        or 'ROLE_ADMIN' in roles
        or 'ROLE_ADMINISTRATEUR' in roles
        or 'ROLE_SUPER_ADMIN' in roles
    %}

    {% set estGestionnaire =
        estAdmin
        or is_granted('ROLE_GESTIONNAIRE')
        or 'ROLE_GESTIONNAIRE' in roles
        or 'GESTIONNAIRE' in roles
    %}

    {% set estJury =
        is_granted('ROLE_JURY')
        or 'ROLE_JURY' in roles
        or 'JURY' in roles
    %}

    {% set estReferent =
        is_granted('ROLE_REFERENT_PARCOURS')
        or is_granted('ROLE_REFERENT')
        or 'ROLE_REFERENT_PARCOURS' in roles
        or 'ROLE_REFERENT' in roles
        or 'REFERENT_PARCOURS' in roles
        or 'REFERENT' in roles
    %}

    {% set estFormateur =
        is_granted('ROLE_FORMATEUR')
        or 'ROLE_FORMATEUR' in roles
        or 'FORMATEUR' in roles
    %}

    {% set estMedical =
        is_granted('ROLE_MEDICAL')
        or 'ROLE_MEDICAL' in roles
        or 'MEDICAL' in roles
    %}

    {% set estApprenti =
        is_granted('ROLE_APPRENTI')
        or 'ROLE_APPRENTI' in roles
        or 'APPRENTI' in roles
    %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Tableau de bord</h1>
            <p class="text-muted">
                Pilotage du recrutement et de l'accompagnement socioprofessionnel.
            </p>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a href="{{ path('dashboard', {design: 'professionnel'}) }}"
           class="btn btn-primary">
            <i class="bi bi-arrow-left-right me-1"></i>
            Découvrir le tableau de bord professionnel
        </a>
    </div>
    {% if stats is defined and stats is iterable %}
        <div class="row g-3">
            {% for k, v in stats %}
                <div class="col-md-3">
                    <div class="card metric shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-muted text-uppercase small">{{ k }}</div>
                            <div class="display-6 fw-bold">{{ v }}</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="row mt-4 g-3">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Vue synthétique du parcours</h5>

                    <div class="progress my-3" style="height: 18px">
                        <div class="progress-bar" style="width: 72%">
                            Recrutement
                        </div>
                    </div>

                    <div class="progress my-3" style="height: 18px">
                        <div class="progress-bar bg-warning text-dark" style="width: 54%">
                            Visites médicales
                        </div>
                    </div>

                    <div class="progress my-3" style="height: 18px">
                        <div class="progress-bar bg-success" style="width: 38%">
                            Suivi
                        </div>
                    </div>

                    <p class="text-muted small mb-0">
                        Les indicateurs visuels ci-dessus sont illustratifs.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Accès rapides

</h5>
<div class="row g-3 mb-3">





</div>

                    <p class="text-muted small">
                        Retrouvez ici les fonctions utiles à votre rôle.
                    </p>
{# BEGIN ACCES RAPIDES EVALUATIONS #}
{% if is_granted('ROLE_GESTIONNAIRE') or is_granted('ROLE_FORMATEUR') or is_granted('ROLE_REFERENT') or is_granted('ROLE_REFERENT_PARCOURS') %}
<a class="btn btn-primary w-100 mb-2" href="{{ path('evaluation_apprenti_index') }}">Évaluations pédagogiques des apprentis</a>
{% endif %}
{% if is_granted('ROLE_APPRENTI') %}
<a class="btn btn-primary w-100 mb-2" href="{{ path('apprenti_evaluations_pedagogiques') }}">Mes évaluations pédagogiques</a>
{% endif %}
{# END ACCES RAPIDES EVALUATIONS #}


                    {% if estAdmin %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('integration_externe_index') }}">
                            <i class="bi bi-person-plus me-1"></i> Intégration des bénéficiaires externes
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('email_information_index') }}">
                            <i class="bi bi-envelope me-1"></i> E-mails d'information
                        </a>
                        {% if is_granted('ROLE_ADMINISTRATEUR') %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('admin_configuration_email_index') }}">
                            <i class="bi bi-envelope-gear me-1"></i> Configuration des e-mails
                        </a>
                        {% endif %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('candidat_index') }}">
                            <i class="bi bi-people me-1"></i> Candidatures
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('admin_campagnes_index') }}">
                            <i class="bi bi-calendar-range me-1"></i> Gestion des campagnes
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('recruitment_interviews') }}">
                            <i class="bi bi-calendar-check me-1"></i> Entretiens et évaluations
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('medical_index') }}">
                            <i class="bi bi-heart-pulse me-1"></i> Visites médicales
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('annuaire') }}">
                            <i class="bi bi-card-list me-1"></i> Annuaires des admis
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('recruitment_admissions') }}">
                            <i class="bi bi-clipboard-check me-1"></i> Décisions d'admission
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('followup_index') }}">
                            <i class="bi bi-person-check me-1"></i> Suivi des apprentis
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('app_etablissements_list') }}">
                            <i class="bi bi-building me-1"></i> Établissements
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('app_metiers_list') }}">
                            <i class="bi bi-tools me-1"></i> Métiers
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('public_inscription') }}">
                            <i class="bi bi-person-plus me-1"></i> Ouvrir une inscription
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('admin_users_index') }}">
                            <i class="bi bi-gear me-1"></i> Gestion des utilisateurs
                        </a>

                    {% elseif estGestionnaire %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('integration_externe_index') }}">
                            <i class="bi bi-person-plus me-1"></i> Intégration des bénéficiaires externes
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('email_information_index') }}">
                            <i class="bi bi-envelope me-1"></i> E-mails d'information
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('candidat_index') }}">
                            <i class="bi bi-people me-1"></i> Candidatures
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('admin_campagnes_index') }}">
                            <i class="bi bi-calendar-range me-1"></i> Gestion des campagnes
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('recruitment_interviews') }}">
                            <i class="bi bi-calendar-check me-1"></i> Entretiens
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('medical_index') }}">
                            <i class="bi bi-heart-pulse me-1"></i> Visites médicales
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('annuaire') }}">
                            <i class="bi bi-card-list me-1"></i> Annuaires des admis
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('recruitment_admissions') }}">
                            <i class="bi bi-clipboard-check me-1"></i> Décisions d'admission
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('followup_index') }}">
                            <i class="bi bi-person-check me-1"></i> Suivi des apprentis
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('app_etablissements_list') }}">
                            <i class="bi bi-building me-1"></i> Établissements
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('app_metiers_list') }}">
                            <i class="bi bi-tools me-1"></i> Métiers
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('public_inscription') }}">
                            <i class="bi bi-person-plus me-1"></i> Ouvrir une inscription
                        </a>

                    {% elseif estJury %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('recruitment_interviews') }}">
                            <i class="bi bi-calendar-check me-1"></i> Mes entretiens
                        </a>
                        <p class="small text-muted mb-0">
                            Ouvrez les entretiens pour accéder aux évaluations des candidats qui vous sont attribués.
                        </p>

                    {% elseif estReferent %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('annuaire') }}">
                            <i class="bi bi-card-list me-1"></i> Annuaire des apprentis
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('followup_index') }}">
                            <i class="bi bi-person-check me-1"></i> Suivi des parcours
                        </a>

                    {% elseif estFormateur %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('followup_index') }}">
                            <i class="bi bi-person-check me-1"></i> Suivi des apprentis
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('annuaire') }}">
                            <i class="bi bi-card-list me-1"></i> Annuaire des apprentis
                        </a>

                    {% elseif estMedical %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('medical_index') }}">
                            <i class="bi bi-heart-pulse me-1"></i> Visites médicales
                        </a>

                    {% elseif estApprenti %}
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_accueil') }}">
                            <i class="bi bi-house me-1"></i> Mon espace apprenti
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_profil') }}">
                            <i class="bi bi-person me-1"></i> Mon profil
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_parcours') }}">
                            <i class="bi bi-signpost-split me-1"></i> Mon parcours
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_rendez_vous') }}">
                            <i class="bi bi-calendar-event me-1"></i> Mes rendez-vous
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_evaluations') }}">
                            <i class="bi bi-clipboard-check me-1"></i> Mes évaluations
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_accompagnement') }}">
                            <i class="bi bi-person-hearts me-1"></i> Mon accompagnement
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('apprenti_notifications') }}">
                            <i class="bi bi-bell me-1"></i> Mes notifications
                            {% if notificationsNonLues|default(0) > 0 %}
                                <span class="badge rounded-pill bg-danger ms-2"
                                      aria-label="{{ notificationsNonLues }} notification(s) non lue(s)">
                                    {{ notificationsNonLues }}
                                </span>
                            {% endif %}
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('app_metiers_list') }}">
                            <i class="bi bi-tools me-1"></i> Consulter les métiers
                        </a>
                        <a class="btn btn-primary w-100 mb-2"
                           href="{{ path('app_etablissements_list') }}">
                            <i class="bi bi-building me-1"></i> Consulter les établissements
                        </a>

                    {% else %}
                        <p class="text-muted small mb-0">
                            Aucun raccourci n'est configuré pour votre rôle.
                            Contactez le gestionnaire si nécessaire.
                        </p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% if is_granted('ROLE_GESTIONNAIRE') %}
<section class="container my-4">
    <div class="card shadow-sm border-0">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h5 mb-1">Administration des etablissements et metiers</h2>
                <p class="text-muted mb-0">Creer, modifier, activer ou retirer les elements des catalogues.</p>
            </div>
            <a class="btn btn-primary" href="{{ path('admin_catalogue_index') }}">Gerer les catalogues</a>
        </div>
    </div>
</section>
{% endif %}
{% endblock %}