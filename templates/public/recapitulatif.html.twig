{% extends 'base.html.twig' %}

{% block title %}Récapitulatif de candidature - MENAET{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10">
            <div class="card border-0 shadow">
                <div class="card-header text-white p-4" style="background:#101f45">
                    <h1 class="h3 mb-2 text-white">Récapitulatif de votre candidature</h1>
                    <p class="mb-0">Vérifiez toutes vos informations avant confirmation.</p>
                </div>

                <div class="card-body p-3 p-md-5">
                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-danger">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-warning">{{ message }}</div>
                    {% endfor %}

                    <div class="alert alert-warning">
                        <strong>Important :</strong> votre candidature ne sera
                        enregistrée définitivement qu'après votre confirmation.
                        Vérifiez soigneusement les informations ci-dessous.
                    </div>

                    <h2 class="h5 border-bottom pb-2 mt-4">1. Identité et état civil</h2>
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Nom</strong><div>{{ data.nom|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Prénoms</strong><div>{{ data.prenoms|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Sexe</strong><div>{{ data.sexe|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Date de naissance</strong><div>{{ data.dateNaissance|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Lieu de naissance</strong><div>{{ data.lieuNaissance|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Nationalité</strong><div>{{ data.nationalite|default('-') }}</div></div>
                        <div class="col-md-6"><strong>Lieu de résidence</strong><div>{{ data.lieuResidence|default('-') }}</div></div>
                        <div class="col-md-3"><strong>Téléphone principal</strong><div>{{ data.telephone|default('-') }}</div></div>
                        <div class="col-md-3"><strong>Téléphone secondaire</strong><div>{{ data.telephoneAlt|default('-') }}</div></div>
                        <div class="col-md-6"><strong>Adresse e-mail</strong><div>{{ data.email|default('-') }}</div></div>
                    </div>

                    <h2 class="h5 border-bottom pb-2 mt-5">2. Pièce d'identité</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <strong>Type de pièce</strong>
                            <div>{{ data.pieceIdentite|default('-') }}</div>
                        </div>
                        <div class="col-md-6">
                            <strong>Justificatif transmis</strong>
                            <div>
                                {% if documents.pieceIdentiteFichier is defined and documents.pieceIdentiteFichier %}
                                    <span class="text-success">Document joint : {{ documents.pieceIdentiteFichier }}</span>
                                {% else %}
                                    <span class="text-secondary">Aucun fichier joint</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <h2 class="h5 border-bottom pb-2 mt-5">3. Formation et diplôme</h2>
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Niveau d'études</strong><div>{{ data.niveau|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Diplôme</strong><div>{{ data.diplome|default('-') }}</div></div>
                        <div class="col-md-4">
                            <strong>Justificatif du diplôme</strong>
                            <div>
                                {% if documents.diplomeFichier is defined and documents.diplomeFichier %}
                                    <span class="text-success">Document joint : {{ documents.diplomeFichier }}</span>
                                {% else %}
                                    <span class="text-secondary">Aucun fichier joint</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <h2 class="h5 border-bottom pb-2 mt-5">4. Métier et disponibilité</h2>
                    <div class="row g-3">
                        <div class="col-md-6"><strong>Métier souhaité</strong><div>{{ data.metier|default('-') }}</div></div>
                        <div class="col-md-6"><strong>Ancien métier</strong><div>{{ data.ancienMetier|default('Aucun') }}</div></div>
                        <div class="col-md-6"><strong>Disponible pour la formation et les stages</strong><div>{{ data.disponibilite|default('-') }}</div></div>
                        <div class="col-md-6"><strong>Date de disponibilité</strong><div>{{ data.disponibleLe|default('-') }}</div></div>
                    </div>

                    <h2 class="h5 border-bottom pb-2 mt-5">5. Contact d'urgence</h2>
                    <div class="row g-3">
                        <div class="col-md-4"><strong>Nom et prénoms</strong><div>{{ data.contactUrgenceNom|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Téléphone</strong><div>{{ data.contactUrgenceTel|default('-') }}</div></div>
                        <div class="col-md-4"><strong>Lien avec le candidat</strong><div>{{ data.contactUrgenceLien|default('-') }}</div></div>
                    </div>

                    <h2 class="h5 border-bottom pb-2 mt-5">6. Expérience professionnelle</h2>
                    <div class="bg-light rounded p-3">
                        {{ data.experience|default('Aucune expérience renseignée.')|nl2br }}
                    </div>

                    <div class="alert alert-info mt-5">
                        Si une information est incorrecte, revenez au formulaire pour la modifier.
                        Après confirmation, votre dossier sera transmis au traitement de la campagne
                        de recrutement.
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-between mt-4">
                        <a href="{{ path('public_inscription') }}" class="btn btn-outline-secondary">
                            Modifier mes informations
                        </a>

                        <form method="post" action="{{ path('public_inscription_confirmer') }}"
                              onsubmit="return confirm('Confirmez-vous l’exactitude des informations de votre candidature ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('public_inscription_confirmer') }}">
<button type="submit" class="btn btn-primary">
                                Confirmer ma candidature
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
