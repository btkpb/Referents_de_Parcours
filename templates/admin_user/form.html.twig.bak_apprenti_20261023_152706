{% extends 'base.html.twig' %}

{% block title %}{{ edition ? 'Modifier un utilisateur' : 'Créer un utilisateur' }} - E2C-MTFPA{% endblock %}

{% block body %}
<div class="container py-4" style="max-width: 850px;">
    <div class="mb-4">
        <a href="{{ path('admin_users_index') }}" class="text-decoration-none">&larr; Retour à la liste</a>
        <h1 class="h3 mt-3">{{ edition ? 'Modifier le compte utilisateur' : 'Créer un utilisateur' }}</h1>
        <p class="text-muted">Les champs marqués d’un astérisque sont obligatoires.</p>
    </div>

    {% if erreurs %}
        <div class="alert alert-danger">
            <strong>Veuillez corriger les éléments suivants :</strong>
            <ul class="mb-0 mt-2">
                {% for erreur in erreurs %}<li>{{ erreur }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="post" class="card card-body shadow-sm">
        <input type="hidden" name="_token" value="{{ csrf_token(edition ? 'user_edit_' ~ utilisateur.id : 'user_create') }}">

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="nom">Nom *</label>
                <input class="form-control" id="nom" name="nom" maxlength="120" required value="{{ utilisateur.nom }}">
            </div>
            <div class="col-md-6">
                <label class="form-label" for="prenoms">Prénoms *</label>
                <input class="form-control" id="prenoms" name="prenoms" maxlength="120" required value="{{ utilisateur.prenoms }}">
            </div>
            <div class="col-12">
                <label class="form-label" for="email">Adresse e-mail *</label>
                <input class="form-control" type="email" id="email" name="email" maxlength="180" required value="{{ utilisateur.email }}">
            </div>
            <div class="col-12">
                <label class="form-label" for="profil">Profil *</label>
                <select class="form-select" id="profil" name="profil" required>
                    {% for cle, libelle in profils %}
                        <option value="{{ cle }}" {% if utilisateur.profil == cle %}selected{% endif %}>{{ libelle }}</option>
                    {% endfor %}
                </select>
                <div class="form-text">Les profils d’administration avancée sont réservés au super administrateur.</div>
            </div>
            <div class="col-12">
                <label class="form-label" for="password">{{ edition ? 'Nouveau mot de passe (facultatif)' : 'Mot de passe initial *' }}</label>
                <input class="form-control" type="password" id="password" name="password" minlength="12" autocomplete="new-password" {% if not edition %}required{% endif %}>
                <div class="form-text">12 caractères minimum. {% if edition %}Laissez vide pour conserver le mot de passe actuel.{% endif %}</div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">{{ edition ? 'Enregistrer les modifications' : 'Créer le compte' }}</button>
            <a class="btn btn-outline-secondary" href="{{ path('admin_users_index') }}">Annuler</a>
        </div>
    </form>
</div>
{% endblock %}