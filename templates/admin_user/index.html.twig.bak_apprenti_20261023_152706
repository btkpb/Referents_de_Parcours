{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs - E2C-MTFPA{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">Gestion des utilisateurs</h1>
            <p class="text-muted mb-0">Créer et administrer les comptes de la plateforme.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('admin_users_new') }}">+ Nouvel utilisateur</a>
    </div>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'success' ? 'success' : 'info') }} alert-dismissible fade show">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-9">
            <input class="form-control" type="search" name="q" value="{{ recherche }}" placeholder="Rechercher par nom, prénom, e-mail ou profil">
        </div>
        <div class="col-sm-3 d-grid">
            <button class="btn btn-outline-primary" type="submit">Rechercher</button>
        </div>
    </form>

    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nom et prénoms</th>
                    <th>E-mail</th>
                    <th>Profil</th>
                    <th>Statut</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for utilisateur in utilisateurs %}
                <tr>
                    <td>{{ utilisateur.nom }} {{ utilisateur.prenoms }}</td>
                    <td>{{ utilisateur.email }}</td>
                    <td>{{ utilisateur.profil|replace({'_':' '})|title }}</td>
                    <td>
                        {% if utilisateur.active %}
                            <span class="badge text-bg-success">Actif</span>
                        {% else %}
                            <span class="badge text-bg-secondary">Désactivé</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary mb-1" href="{{ path('admin_users_edit', {id: utilisateur.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('admin_users_status', {id: utilisateur.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('user_status_' ~ utilisateur.id) }}">
                            {% if utilisateur.active %}
                                <button class="btn btn-sm btn-outline-danger mb-1" type="submit" onclick="return confirm('Désactiver ce compte ?')">Désactiver</button>
                            {% else %}
                                <button class="btn btn-sm btn-outline-success mb-1" type="submit">Activer</button>
                            {% endif %}
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="text-center py-4">Aucun utilisateur trouvé.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-3">Nombre de comptes affichés : {{ utilisateurs|length }}</p>
</div>
{% endblock %}