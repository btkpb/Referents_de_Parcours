{% extends 'base.html.twig' %}

{% block title %}
    {{ edition ? 'Modifier un utilisateur' : 'Créer un utilisateur' }} - E2C-MENAET
{% endblock %}

{% block body %}
<style>
    .user-page {
        max-width: 1100px;
        margin: 25px auto;
        padding: 0 15px 35px;
    }

    .user-header {
        background: linear-gradient(120deg, #174675, #5B9BD5);
        color: white;
        padding: 30px;
        border-radius: 16px;
        margin-bottom: 25px;
        box-shadow: 0 8px 24px rgba(23,70,117,.16);
    }

    .user-header h1 {
        color: #fff;
        font-size: 2.4rem;
        font-weight: 900;
        margin-bottom: 8px;
        letter-spacing: .3px;
    }

    .user-header p {
        color: #eef6ff;
        margin-bottom: 0;
    }

    .user-card {
        background: #fff;
        border: 1px solid #e4eaf1;
        border-radius: 14px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(20,50,80,.05);
    }

    .user-card h2 {
        color: #174675;
        font-size: 1.15rem;
        font-weight: 700;
        padding-bottom: 14px;
        margin-bottom: 20px;
        border-bottom: 1px solid #e8edf3;
    }

    .user-card h2 i {
        margin-right: 8px;
    }

    .form-label {
        color: #34495e;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .form-control, .form-select {
        min-height: 45px;
        border-radius: 8px;
        border-color: #d7e0ea;
    }

    .form-control:focus, .form-select:focus {
        border-color: #5B9BD5;
        box-shadow: 0 0 0 .2rem rgba(91,155,213,.16);
    }

    .form-help {
        color: #718096;
        font-size: .85rem;
        margin-top: 6px;
    }

    .user-actions {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .user-actions .btn {
        border-radius: 8px;
        padding: 11px 20px;
        font-weight: 600;
    }

    .btn-e2c {
        background: #174675;
        color: white;
        border: 1px solid #174675;
    }

    .btn-e2c:hover {
        background: #10365d;
        color: white;
    }

    #candidateField {
        display: none;
        background: #f1f7fd;
        border: 1px solid #d5e7f8;
        border-radius: 10px;
        padding: 18px;
        margin-top: 18px;
    }

    .required-mark {
        color: #dc3545;
    }

    @media (max-width: 576px) {
        .user-header, .user-card {
            padding: 20px;
        }

        .user-actions {
            flex-direction: column;
        }

        .user-actions .btn {
            width: 100%;
        }
    }
</style>

<div class="user-page">

    <div class="user-header">
        <div class="d-flex align-items-center gap-3">
            <div>
                <i class="bi bi-person-plus-fill" style="font-size:2.5rem;"></i>
            </div>
            <div>
                <h1>{{ edition ? 'Modifier un utilisateur' : 'Nouvel utilisateur' }}</h1>
                <p>
                    Administration des comptes et attribution des profils
                    de la plateforme E2C-MENAET.
                </p>
            </div>
        </div>
    </div>

    {% if erreurs is defined and erreurs is not empty %}
        <div class="alert alert-danger">
            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Veuillez corriger les erreurs suivantes :</strong>
            <ul class="mb-0 mt-2">
                {% for erreur in erreurs %}
                    <li>{{ erreur }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="post" novalidate>

        <div class="user-card">
            <h2><i class="bi bi-person-vcard"></i> Informations personnelles</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="nom" class="form-label">
                        Nom <span class="required-mark">*</span>
                    </label>
                    <input type="text" id="nom" name="nom"
                           class="form-control" required
                           value="{{ utilisateur.nom|default('') }}"
                           placeholder="Nom de famille">
                </div>

                <div class="col-md-6">
                    <label for="prenoms" class="form-label">
                        Prénoms <span class="required-mark">*</span>
                    </label>
                    <input type="text" id="prenoms" name="prenoms"
                           class="form-control" required
                           value="{{ utilisateur.prenoms|default('') }}"
                           placeholder="Prénom(s)">
                </div>

                <div class="col-12">
                    <label for="email" class="form-label">
                        Adresse e-mail <span class="required-mark">*</span>
                    </label>
                    <input type="email" id="email" name="email"
                           class="form-control" required
                           value="{{ utilisateur.email|default('') }}"
                           placeholder="exemple@domaine.ci">
                    <div class="form-help">Cette adresse sera utilisée pour la connexion à la plateforme.</div>
                </div>
            </div>
        </div>

        <div class="user-card">
            <h2><i class="bi bi-person-gear"></i> Profil et affectation</h2>

            <div class="row g-3">
                <div class="col-12">
                    <label for="profil" class="form-label">
                        Profil utilisateur <span class="required-mark">*</span>
                    </label>
                    <select id="profil" name="profil" class="form-select" required>
                        <option value="">-- Sélectionner un profil --</option>
                        {% for code, libelle in profils %}
                            <option value="{{ code }}"
                                {% if utilisateur.profil|default('') == code %}selected{% endif %}>
                                {{ libelle }}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="form-help">Le profil détermine les fonctionnalités accessibles à l'utilisateur.</div>
                </div>

                <div class="col-12" id="candidateField">
                    <label for="candidate_id" class="form-label">
                        Candidat à rattacher <span class="required-mark">*</span>
                    </label>
                    <select id="candidate_id" name="candidat_id" class="form-select">
                        <option value="">-- Sélectionner un candidat --</option>
                        {% for candidat in candidats %}
                            <option value="{{ candidat.id }}"
                                {% if utilisateur.candidat and utilisateur.candidat.id == candidat.id %}selected{% endif %}>
                                {{ candidat.nom }} {{ candidat.prenoms }}
                            </option>
                        {% endfor %}
                    </select>
                    <div class="form-help">
                        Ce rattachement est nécessaire pour créer un compte de profil apprenti.
                    </div>
                </div>
            </div>
        </div>

        <div class="user-card">
            <h2><i class="bi bi-shield-lock"></i> Sécurité du compte</h2>

            <div class="row g-3">
                <div class="col-12">
                    <label for="password" class="form-label">
                        {{ edition ? 'Nouveau mot de passe' : 'Mot de passe' }}
                        {% if not edition %}<span class="required-mark">*</span>{% endif %}
                    </label>
                    <input type="password" id="password" name="password"
                           class="form-control"
                           {% if not edition %}required{% endif %}
                           minlength="12"
                           autocomplete="new-password"
                           placeholder="{{ edition ? 'Laisser vide pour conserver le mot de passe actuel' : '12 caractères minimum' }}">
                    <div class="form-help">
                        12 caractères minimum. En modification, laissez ce champ vide pour conserver le mot de passe actuel.
                    </div>

                    <div class="mt-3">
                        <label for="confirmation_password" class="form-label">
                            Confirmer le mot de passe
                            {% if not edition %}<span class="required-mark">*</span>{% endif %}
                        </label>
                        <input type="password"
                               id="confirmation_password"
                               name="confirmation_password"
                               class="form-control"
                               {% if not edition %}required{% endif %}
                               minlength="12"
                               autocomplete="new-password"
                               placeholder="Saisissez à nouveau le mot de passe">
                        <div class="form-help">
                            Les deux mots de passe doivent être identiques.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <input type="hidden" name="_token"
               value="{{ csrf_token(edition ? 'user_edit_' ~ utilisateur.id : 'user_create') }}">

        <div class="user-actions">
            <a href="{{ path('admin_users_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i>Retour à la liste
            </a>

            <button type="submit" class="btn btn-e2c">
                <i class="bi bi-check-circle me-2"></i>
                {{ edition ? 'Enregistrer les modifications' : 'Créer le compte utilisateur' }}
            </button>
        </div>

    </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const profil = document.getElementById('profil');
    const candidateField = document.getElementById('candidateField');
    const candidateSelect = document.getElementById('candidate_id');

    function updateCandidateField() {
        const isApprenti = profil.value === 'apprenti';

        candidateField.style.display = isApprenti ? 'block' : 'none';
        candidateSelect.required = isApprenti;

        if (!isApprenti) {
            candidateSelect.value = '';
        }
    }

    profil.addEventListener('change', updateCandidateField);
    updateCandidateField();
});
</script>
{% endblock %}