{% extends 'base.html.twig' %}

{% block title %}{{ edition ? 'Modifier une évaluation' : 'Nouvelle évaluation pédagogique' }}{% endblock %}

{% block body %}
<div class="e2c-evaluation-form">
    <style>
        .e2c-evaluation-form {
            --e2c-navy: #142b4a;
            --e2c-navy-light: #203e63;
            --e2c-gold: #d6ad55;
            --e2c-bg: #f3f6fa;
            --e2c-text: #26364a;
            background: var(--e2c-bg);
            min-height: 100vh;
            padding: 30px 0 55px;
            color: var(--e2c-text);
        }
        .e2c-evaluation-form .page-wrap {
            max-width: 1120px;
            margin: auto;
            padding: 0 18px;
        }
        .e2c-evaluation-form .hero {
            position: relative;
            overflow: hidden;
            background: linear-gradient(125deg, var(--e2c-navy), var(--e2c-navy-light));
            color: #fff;
            border-radius: 18px;
            padding: 30px 34px;
            margin-bottom: 24px;
            box-shadow: 0 12px 28px rgba(20,43,74,.15);
        }
        .e2c-evaluation-form .hero:after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border: 30px solid rgba(255,255,255,.06);
            border-radius: 50%;
            right: -65px;
            top: -100px;
        }
        .e2c-evaluation-form .hero h1 {
            color: #fff;
            font-weight: 800;
            font-size: clamp(1.45rem, 3vw, 2rem);
            margin: 8px 0;
        }
        .e2c-evaluation-form .hero p {
            color: rgba(255,255,255,.78);
            margin: 0;
        }
        .e2c-evaluation-form .eyebrow {
            color: var(--e2c-gold);
            font-size: .76rem;
            font-weight: 800;
            letter-spacing: .12em;
            text-transform: uppercase;
        }
        .e2c-evaluation-form .main-card {
            border: 1px solid #e3e9f0;
            border-radius: 17px;
            background: #fff;
            box-shadow: 0 8px 24px rgba(26,45,70,.06);
            overflow: hidden;
        }
        .e2c-evaluation-form .section-heading {
            display: flex;
            align-items: center;
            gap: 13px;
            margin: 0 0 20px;
            color: var(--e2c-navy);
            font-size: 1.08rem;
            font-weight: 800;
        }
        .e2c-evaluation-form .section-number {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            color: var(--e2c-navy);
            background: #f8efd9;
            border: 1px solid #eeddb6;
            font-weight: 800;
            flex: 0 0 34px;
        }
        .e2c-evaluation-form .section-block {
            padding: 28px 30px;
            border-bottom: 1px solid #edf1f5;
        }
        .e2c-evaluation-form .form-label {
            color: #34465d;
            font-weight: 700;
            font-size: .9rem;
            margin-bottom: 7px;
        }
        .e2c-evaluation-form .form-control,
        .e2c-evaluation-form .form-select {
            min-height: 46px;
            border: 1px solid #d9e1eb;
            border-radius: 10px;
            color: #25364b;
            background-color: #fff;
        }
        .e2c-evaluation-form textarea.form-control {
            min-height: 105px;
            resize: vertical;
        }
        .e2c-evaluation-form .form-control:focus,
        .e2c-evaluation-form .form-select:focus {
            border-color: #7895b7;
            box-shadow: 0 0 0 .2rem rgba(32,62,99,.11);
        }
        .e2c-evaluation-form .form-text {
            color: #718096;
            font-size: .82rem;
        }
        .e2c-evaluation-form .score-card {
            height: 100%;
            padding: 17px;
            border: 1px solid #e2e9f1;
            border-radius: 13px;
            background: #fbfcfe;
            transition: border-color .2s, box-shadow .2s;
        }
        .e2c-evaluation-form .score-card:focus-within {
            border-color: #9aafc8;
            box-shadow: 0 5px 16px rgba(20,43,74,.07);
        }
        .e2c-evaluation-form .score-card .form-label {
            min-height: 24px;
            display: block;
        }
        .e2c-evaluation-form .score-input-wrap {
            position: relative;
        }
        .e2c-evaluation-form .score-input-wrap .form-control {
            padding-right: 55px;
            font-size: 1.15rem;
            font-weight: 800;
        }
        .e2c-evaluation-form .score-unit {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #7a8797;
            font-size: .83rem;
            font-weight: 700;
            pointer-events: none;
        }
        .e2c-evaluation-form .score-summary {
            background: linear-gradient(120deg, #142b4a, #203e63);
            color: #fff;
            border-radius: 15px;
            padding: 22px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 18px;
            margin-top: 22px;
        }
        .e2c-evaluation-form .score-summary .summary-label {
            color: rgba(255,255,255,.76);
            font-size: .88rem;
        }
        .e2c-evaluation-form .score-total {
            color: #fff;
            font-size: 2rem;
            font-weight: 900;
            line-height: 1.1;
            white-space: nowrap;
        }
        .e2c-evaluation-form .score-total small {
            color: var(--e2c-gold);
            font-size: .95rem;
            font-weight: 700;
        }
        .e2c-evaluation-form .progress {
            height: 8px;
            background: rgba(255,255,255,.18);
            border-radius: 20px;
            margin-top: 12px;
        }
        .e2c-evaluation-form .progress-bar {
            background: var(--e2c-gold);
            border-radius: 20px;
            transition: width .2s ease;
        }
        .e2c-evaluation-form .form-actions {
            padding: 24px 30px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            background: #fbfcfe;
        }
        .e2c-evaluation-form .btn-save {
            background: var(--e2c-navy);
            color: #fff;
            border: 1px solid var(--e2c-navy);
            border-radius: 10px;
            padding: 11px 21px;
            font-weight: 800;
        }
        .e2c-evaluation-form .btn-save:hover {
            background: var(--e2c-navy-light);
            color: #fff;
        }
        .e2c-evaluation-form .btn-cancel {
            border-radius: 10px;
            padding: 11px 19px;
            font-weight: 700;
        }
        .e2c-evaluation-form .required-note {
            font-size: .8rem;
            color: #718096;
        }
        @media (max-width: 767px) {
            .e2c-evaluation-form { padding-top: 15px; }
            .e2c-evaluation-form .hero { padding: 23px 21px; border-radius: 14px; }
            .e2c-evaluation-form .section-block { padding: 22px 18px; }
            .e2c-evaluation-form .form-actions { padding: 20px 18px; }
            .e2c-evaluation-form .score-summary { align-items: flex-start; flex-direction: column; }
            .e2c-evaluation-form .form-actions .btn { width: 100%; }
        }
    </style>

    <div class="page-wrap">
        <header class="hero">
            <div class="eyebrow">Suivi pédagogique des apprentis</div>
            <h1>{{ edition ? 'Modifier une évaluation' : 'Nouvelle évaluation pédagogique' }}</h1>
            <p>Évaluer les compétences, mesurer les progrès et accompagner la progression professionnelle.</p>
        </header>

        {% for typeFlash, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ typeFlash }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="main-card">
            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">

                <section class="section-block">
                    <h2 class="section-heading">
                        <span class="section-number">1</span>
                        Informations générales
                    </h2>

                    <div class="row g-3">
                        <div class="col-lg-6">
                            <label class="form-label" for="candidat_id">Apprenti admis <span class="text-danger">*</span></label>
                            {% if edition %}
                                <input type="hidden" name="candidat_id" value="{{ item.candidat_id }}">
                                <select id="candidat_id" class="form-select" disabled>
                                    {% for c in candidats %}
                                        <option value="{{ c.id }}" {% if c.id == item.candidat_id %}selected{% endif %}>
                                            {{ c.nom }} {{ c.prenoms }} — {{ c.numero }}
                                        </option>
                                    {% endfor %}
                                </select>
                                <div class="form-text">L'apprenti associé à cette évaluation ne peut pas être changé.</div>
                            {% else %}
                                <select id="candidat_id" name="candidat_id" class="form-select" required>
                                    <option value="">Sélectionner un apprenti</option>
                                    {% for c in candidats %}
                                        <option value="{{ c.id }}" {% if c.id == item.candidat_id %}selected{% endif %}>
                                            {{ c.nom }} {{ c.prenoms }} — {{ c.numero }}
                                        </option>
                                    {% endfor %}
                                </select>
                                {% if candidats is empty %}
                                    <div class="form-text text-danger">Aucun apprenti admis n'est disponible pour le moment.</div>
                                {% endif %}
                            {% endif %}
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label class="form-label" for="date_evaluation">Date de l'évaluation <span class="text-danger">*</span></label>
                            <input id="date_evaluation" type="date" name="date_evaluation"
                                   class="form-control"
                                   value="{{ item.date_evaluation|default('')|date('Y-m-d') }}"
                                   required>
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label class="form-label" for="type_evaluation">Type d'évaluation <span class="text-danger">*</span></label>
                            <select id="type_evaluation" name="type_evaluation" class="form-select" required>
                                <option value="DEBUT" {% if item.type_evaluation == 'DEBUT' %}selected{% endif %}>Début</option>
                                <option value="PERIODIQUE" {% if item.type_evaluation == 'PERIODIQUE' %}selected{% endif %}>Périodique</option>
                                <option value="STAGE" {% if item.type_evaluation == 'STAGE' %}selected{% endif %}>Stage</option>
                                <option value="FINALE" {% if item.type_evaluation == 'FINALE' %}selected{% endif %}>Finale</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="section-block">
                    <h2 class="section-heading">
                        <span class="section-number">2</span>
                        Grille d'évaluation des compétences
                    </h2>
                    <p class="text-muted mb-4">Attribuez une note de 0 à 20 pour chacun des cinq critères. Le total est calculé automatiquement sur 100 points.</p>

                    {% set criteres = {
                        'score_technique': 'Compétences techniques',
                        'score_qualite': 'Qualité du travail',
                        'score_securite': 'Sécurité au travail',
                        'score_assiduite': 'Assiduité et ponctualité',
                        'score_autonomie': 'Autonomie professionnelle'
                    } %}

                    <div class="row g-3">
                        {% for champ, libelle in criteres %}
                            <div class="col-md-6 col-lg-4">
                                <div class="score-card">
                                    <label class="form-label" for="{{ champ }}">{{ loop.index }}. {{ libelle }} <span class="text-danger">*</span></label>
                                    <div class="score-input-wrap">
                                        <input id="{{ champ }}" type="number" name="{{ champ }}"
                                               class="form-control score-field"
                                               min="0" max="20" step="0.5"
                                               value="{{ item[champ]|default(0) }}"
                                               required inputmode="decimal">
                                        <span class="score-unit">/ 20</span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="score-summary" aria-live="polite">
                        <div class="flex-grow-1 w-100">
                            <div class="summary-label">Résultat global de l'évaluation</div>
                            <div class="progress">
                                <div id="scoreProgress" class="progress-bar" role="progressbar" style="width:0%" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
                            </div>
                        </div>
                        <div>
                            <div class="score-total"><span id="scoreTotal">0</span> <small>/ 100</small></div>
                            <div class="summary-label text-end">Total des cinq critères</div>
                        </div>
                    </div>
                </section>

                <section class="section-block">
                    <h2 class="section-heading">
                        <span class="section-number">3</span>
                        Observations pédagogiques
                    </h2>

                    <div class="mb-4">
                        <label class="form-label" for="points_forts">Points forts observés</label>
                        <textarea id="points_forts" name="points_forts" class="form-control"
                                  rows="3" maxlength="10000"
                                  placeholder="Décrivez les compétences maîtrisées, les réussites et les progrès constatés...">{{ item.points_forts|default('') }}</textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="axes_amelioration">Axes d'amélioration</label>
                        <textarea id="axes_amelioration" name="axes_amelioration" class="form-control"
                                  rows="3" maxlength="10000"
                                  placeholder="Précisez les difficultés observées et les compétences à renforcer...">{{ item.axes_amelioration|default('') }}</textarea>
                    </div>

                    <div>
                        <label class="form-label" for="commentaire">Commentaire général du formateur</label>
                        <textarea id="commentaire" name="commentaire" class="form-control"
                                  rows="4" maxlength="10000"
                                  placeholder="Ajoutez votre appréciation générale et vos recommandations pédagogiques...">{{ item.commentaire|default('') }}</textarea>
                    </div>
                </section>

                <footer class="form-actions">
                    <div class="required-note"><span class="text-danger">*</span> Champs obligatoires — Enregistrement en brouillon</div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="{{ path('evaluation_apprenti_index') }}" class="btn btn-outline-secondary btn-cancel">Annuler</a>
                        <button type="submit" class="btn btn-save">Enregistrer l'évaluation</button>
                    </div>
                </footer>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const fields = document.querySelectorAll('.e2c-evaluation-form .score-field');
    const totalElement = document.getElementById('scoreTotal');
    const progressElement = document.getElementById('scoreProgress');

    function updateTotal() {
        let total = 0;

        fields.forEach(function (field) {
            const value = field.value.trim() === '' ? 0 : Number(field.value);
            if (Number.isFinite(value)) {
                total += Math.min(20, Math.max(0, value));
            }
        });

        total = Math.round(total * 100) / 100;
        totalElement.textContent = Number.isInteger(total) ? total : total.toFixed(2).replace('.', ',');
        progressElement.style.width = Math.min(100, total) + '%';
        progressElement.setAttribute('aria-valuenow', String(Math.min(100, total)));
    }

    fields.forEach(function (field) {
        field.addEventListener('input', updateTotal);
        field.addEventListener('change', updateTotal);
    });

    updateTotal();
});
</script>
{% endblock %}